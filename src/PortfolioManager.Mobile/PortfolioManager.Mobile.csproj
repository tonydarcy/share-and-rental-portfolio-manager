<Project Sdk="Microsoft.NET.Sdk">

  <!-- The phone app (.NET MAUI). Android builds anywhere with the maui-android workload; iOS needs a Mac.
       It is kept out of PortfolioManager.slnx so the site's build doesn't need the phone workloads: the
       "Android app" GitHub workflow builds it. Sign-in and API calls live in PortfolioManager.Mobile.Client. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PortfolioManager.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Share Portfolio</ApplicationTitle>
    <ApplicationId>com.shareportfoliomanager.app</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- A test build anyone can install by hand (sideload): one APK, not the Play Store's AAB -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#212529" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#212529" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PortfolioManager.Mobile.Client\PortfolioManager.Mobile.Client.csproj" />
  </ItemGroup>

</Project>
