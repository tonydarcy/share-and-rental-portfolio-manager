@page
@model PortfolioManager.Web.Pages.Account.ActivityModel
@{
    ViewData["Title"] = "Recent sign-ins";
}

<h1 class="h2 pb-2 mb-3 border-bottom">Recent sign-ins</h1>
<p class="text-muted">
    Sign-ins to your account, wrong passwords or codes typed against your email, and changes to your password,
    two-factor sign-in and API keys. If you see something you don't recognise, reset your password (log out, then
    Forgot password) and turn on <a asp-page="/Account/TwoFactor">two-factor sign-in</a>. Resetting your password signs
    out every other browser.
</p>

@if (Model.Events.Count == 0)
{
    <div class="alert alert-info">Nothing recorded yet.</div>
    return;
}
<div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>When</th><th>What</th><th>Result</th><th>Internet address</th><th>Browser</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Events)
            {
                <tr class="@(e.Success ? "" : "table-warning")">
                    <td class="text-nowrap"><time datetime="@e.WhenUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">@e.WhenUtc.ToString("d MMM yyyy HH:mm") UTC</time></td>
                    <td>@e.Event</td>
                    <td>@(e.Success ? "OK" : "Wrong")</td>
                    <td>@e.IpAddress</td>
                    <td title="@e.UserAgent">@PortfolioManager.Web.Pages.Account.ActivityModel.Browser(e.UserAgent)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        // Show the times in this device's own time zone
        document.querySelectorAll('time[datetime]').forEach(t => {
            const d = new Date(t.getAttribute('datetime'));
            if (!isNaN(d)) t.textContent = d.toLocaleString(undefined, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        });
    </script>
}
