@page
@model PortfolioManager.Web.Pages.Account.ApiKeysModel
@{
    ViewData["Title"] = "API keys";
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">API keys and AI assistants</h1>
</div>

@if (Model.LoadError is not null)
{
    <div class="alert alert-warning">@Model.LoadError</div>
    return;
}

@if (Model.NewKey is not null)
{
    <div class="alert alert-success">
        <p class="mb-2"><strong>Here is your new key.</strong> Copy it now: it won't be shown again. Keep it secret, like a password.</p>
        <div class="input-group">
            <input type="text" class="form-control font-monospace" value="@Model.NewKey" readonly id="newKey" onclick="this.select()" />
            <button type="button" class="btn btn-outline-secondary" onclick="navigator.clipboard.writeText(document.getElementById('newKey').value); this.textContent='Copied';">Copy</button>
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm mb-3">
            <div class="card-body pb-0"><h2 class="h6">Your keys</h2></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light"><tr><th>Name</th><th>Key starts</th><th>Can</th><th>Created</th><th>Last used</th><th></th></tr></thead>
                    <tbody>
                        @if (Model.Keys.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted p-4">No keys yet.</td></tr>
                        }
                        @foreach (var k in Model.Keys)
                        {
                            <tr class="@(k.Active ? "" : "text-muted")">
                                <td>@k.Name</td>
                                <td class="font-monospace small">@k.Prefix…</td>
                                <td>@(k.ReadOnly ? "Look only" : "Look and change")</td>
                                <td class="small">@k.Created.ToString("d")</td>
                                <td class="small">@(k.LastUsed?.ToString("g") ?? "Never")</td>
                                <td class="text-end">
                                    @if (k.Active)
                                    {
                                        <form method="post" asp-page-handler="Revoke" asp-route-apiKeyId="@k.ApiKeyId" class="d-inline"
                                              data-confirm="Revoke the key &quot;@k.Name&quot;? Anything using it stops working." onsubmit="return confirm(this.dataset.confirm);">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="small">Revoked @k.Revoked!.Value.ToString("d")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body pb-0">
                <h2 class="h6">What agents and apps changed</h2>
                <p class="small text-muted mb-2">
                    Every change made with an API key, or refused, newest first: changes made with your keys, and changes anyone made
                    with their keys in portfolios you own.
                </p>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 small">
                    <thead class="table-light"><tr><th>When</th><th>Portfolio</th><th>Key</th><th>What</th><th>Result</th></tr></thead>
                    <tbody>
                        @if (Model.Activity.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted p-4">Nothing yet.</td></tr>
                        }
                        @foreach (var a in Model.Activity)
                        {
                            <tr>
                                <td class="text-nowrap">@a.When.ToString("g")</td>
                                <td>@a.PortfolioName</td>
                                <td>@a.KeyName<br /><span class="text-muted">@a.KeyOwner</span></td>
                                <td>
                                    <code>@a.Action</code>
                                    <details><summary class="text-muted">Details</summary><pre class="small mb-0 text-wrap">@a.Detail</pre></details>
                                </td>
                                <td>
                                    @if (a.Succeeded) { <span class="badge text-bg-success">Done</span> }
                                    else { <span class="badge text-bg-danger">Refused</span> <span>@a.Result</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <form method="post" asp-page-handler="Create" class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h6">Make a key</h2>
                <p class="text-muted small">
                    A key lets an AI assistant such as Claude, or another app, work with your portfolios as you. It reaches the same
                    portfolios you can, with the same role: on a portfolio you can only look at, it can only look too.
                </p>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">What will use it</label>
                    <input asp-for="Name" class="form-control" maxlength="100" placeholder="e.g. Claude on my laptop" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" asp-for="ReadOnly" />
                    <label class="form-check-label" asp-for="ReadOnly"><strong>Read only:</strong> it can look at everything but change nothing</label>
                </div>
                <button type="submit" class="btn btn-primary">Make key</button>
            </div>
        </form>

        <div class="card shadow-sm">
            <div class="card-body small">
                <h2 class="h6">Connecting an AI assistant</h2>
                <p>The MCP server address is <code>@Model.BaseUrl/mcp</code>. Send the key as a header:
                    <code>Authorization: Bearer pm_...</code></p>
                <p class="mb-1">Claude Code:</p>
                <pre class="bg-light p-2 text-wrap"><code>claude mcp add --transport http portfolio @Model.BaseUrl/mcp --header "Authorization: Bearer YOUR_KEY"</code></pre>
                <p class="mb-1">Other apps can call the JSON API, for example:</p>
                <pre class="bg-light p-2 text-wrap"><code>curl -H "Authorization: Bearer YOUR_KEY" @Model.BaseUrl/api/v1/portfolios</code></pre>
                <p class="mb-0">See the list of what it can do at <code>@Model.BaseUrl/api/v1/tools</code>.
                    Revoke a key here as soon as you stop using it, or if it may have been seen by someone else.</p>
            </div>
        </div>
    </div>
</div>
