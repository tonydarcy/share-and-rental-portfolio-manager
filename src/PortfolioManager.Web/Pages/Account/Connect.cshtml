@page
@model PortfolioManager.Web.Pages.Account.ConnectModel
@inject SiteBranding Site
@{
    ViewData["Title"] = "Connect an app";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                @if (Model.Asked is null)
                {
                    <h1 class="h4 mb-3">Connect an app</h1>
                    <div class="alert alert-warning mb-0">@(Model.Error ?? "Start from the app you want to connect, such as Claude.")</div>
                }
                else
                {
                    var redirect = new Uri(Model.Asked.RedirectUri);
                    <h1 class="h4 mb-3">Connect @(Model.Asked.Client.Name)?</h1>
                    <p>
                        <strong>@Model.Asked.Client.Name</strong> wants to work with your @Site.Name portfolios as you
                        (<strong>@User.Identity?.Name</strong>). It reaches the same portfolios you can, with the same role.
                    </p>
                    <p class="small text-muted">
                        After you choose, you go back to <code>@redirect.Host</code>. Only allow apps you started connecting yourself.
                    </p>
                    <form method="post">
                        @foreach (var f in Model.Carried)
                        {
                            <input type="hidden" name="@f.Key" value="@f.Value" />
                        }
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="ReadOnly" />
                            <label class="form-check-label" asp-for="ReadOnly"><strong>Read only:</strong> it can look at everything but change nothing</label>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" asp-page-handler="Allow">Allow</button>
                            <button type="submit" class="btn btn-outline-secondary" asp-page-handler="Deny">Don't allow</button>
                        </div>
                    </form>
                    <p class="small text-muted mt-3 mb-0">
                        It shows on <a asp-page="/Account/ApiKeys">API keys and AI assistants</a>, with everything it changes.
                        Revoke it there to disconnect it.
                    </p>
                }
            </div>
        </div>
    </div>
</div>
