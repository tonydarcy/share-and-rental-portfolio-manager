@page
@model PortfolioManager.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Forgot your password</h1>
                @if (!Model.CanSendEmail)
                {
                    <p>This site isn't set up to send email, so it can't send a reset link. Please ask the site's administrator to reset your password.</p>
                }
                else if (Model.Sent)
                {
                    <div class="alert alert-success" role="status">
                        If an account uses @Model.Email, we've emailed it a link to choose a new password. The link works for 2 hours.
                        Check your junk folder if it doesn't arrive in a few minutes.
                    </div>
                }
                else
                {
                    <p class="small">Enter the email you log in with and we'll email you a link to choose a new password.</p>
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <partial name="_Captcha" />
                        <button type="submit" class="btn btn-primary w-100">Email me a link</button>
                    </form>
                }
                <p class="text-center small mt-3 mb-0"><a asp-page="/Account/Login">Back to log in</a></p>
            </div>
        </div>
    </div>
</div>
