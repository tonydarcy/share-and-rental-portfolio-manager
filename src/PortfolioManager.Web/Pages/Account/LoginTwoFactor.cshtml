@page
@model PortfolioManager.Web.Pages.Account.LoginTwoFactorModel
@{
    ViewData["Title"] = "Two-factor sign-in";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Enter your code</h1>
                <p class="small">Open your authenticator app and enter the 6-digit code it shows for this site. Lost your phone? Enter one of your recovery codes instead.</p>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code" class="form-control" autocomplete="one-time-code" inputmode="text" autofocus />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Log in</button>
                </form>
                <p class="text-center small mt-3 mb-0"><a asp-page="/Account/Login">Start again</a></p>
            </div>
        </div>
    </div>
</div>
