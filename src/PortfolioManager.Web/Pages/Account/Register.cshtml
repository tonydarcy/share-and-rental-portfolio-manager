@page
@model PortfolioManager.Web.Pages.Account.RegisterModel
@using PortfolioManager.Core.Accounts
@{
    ViewData["Title"] = "Create an account";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Create an account</h1>
                <form method="post">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" autocomplete="email" maxlength="254" required autofocus />
                    </div>
                    <div class="mb-3">
                        <label asp-for="ContactName" class="form-label"></label>
                        <input asp-for="ContactName" class="form-control" autocomplete="name" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="PortfolioName" class="form-label"></label>
                        <input asp-for="PortfolioName" class="form-control" maxlength="100" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" minlength="@AccountService.MinPasswordLength" required />
                        <div class="form-text">At least @AccountService.MinPasswordLength characters. A short phrase is easier to remember.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
                    </div>
                    @if (Model.Legal.Enabled)
                    {
                        <div class="form-check mb-3">
                            <input asp-for="AgreeToTerms" class="form-check-input" />
                            <label asp-for="AgreeToTerms" class="form-check-label">
                                I agree to the
                                <a href="@(string.IsNullOrWhiteSpace(Model.Legal.TermsUrl) ? Url.Page("/Legal/Terms") : Model.Legal.TermsUrl)" target="_blank" rel="noopener">terms of use</a>
                                and
                                <a href="@(string.IsNullOrWhiteSpace(Model.Legal.PrivacyUrl) ? Url.Page("/Legal/Privacy") : Model.Legal.PrivacyUrl)" target="_blank" rel="noopener">privacy policy</a>
                            </label>
                        </div>
                    }
                    <partial name="_Captcha" />
                    <button type="submit" class="btn btn-primary w-100">Create account</button>
                </form>
                <p class="text-center small mt-3 mb-0">Already have an account? <a asp-page="/Account/Login">Log in</a></p>
            </div>
        </div>
    </div>
</div>
