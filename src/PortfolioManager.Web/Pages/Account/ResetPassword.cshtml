@page
@model PortfolioManager.Web.Pages.Account.ResetPasswordModel
@using PortfolioManager.Core.Accounts
@{
    ViewData["Title"] = "Choose a new password";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Choose a new password</h1>
                @if (!Model.LinkWorks)
                {
                    <p>This link has expired or has already been used. <a asp-page="/Account/ForgotPassword">Ask for a new one</a>.</p>
                }
                else
                {
                    <form method="post">
                        <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                        <input type="hidden" asp-for="Token" />
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" minlength="@AccountService.MinPasswordLength" required autofocus />
                            <div class="form-text">At least @AccountService.MinPasswordLength characters.</div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Change password</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
