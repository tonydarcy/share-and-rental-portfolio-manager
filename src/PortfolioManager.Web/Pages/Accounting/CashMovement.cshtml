@page
@model CashMovementModel
@{
    ViewData["Title"] = "Cash movement";
    var r = Model.Report;
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <div>
        <h1 class="h2 mb-0">Cash movement</h1>
        @if (Model.Portfolio is not null)
        {
            <div class="text-muted">@Model.Portfolio.Name &middot; @Model.Period.Description</div>
        }
    </div>
    <div class="d-flex gap-2">
        <partial name="_FyShortcuts" model="Model" />
        <button type="button" class="btn btn-sm btn-outline-secondary no-print" onclick="window.print()"><i class="bi bi-printer"></i> Print / PDF</button>
    </div>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}

<partial name="_ModeNotice" model="Model.Mode" />
<p class="text-muted small no-print">
    Where the cash came from and went, from the ledger: profit, then movements in the other balance sheet accounts,
    reconciled to the change in the bank accounts (1100 to 1199).
</p>
<partial name="~/Pages/Reports/_PeriodFilter.cshtml" model="Model" />

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Net profit</div>
            <div class="kpi-value @PortfolioManager.Web.Pages.Reports.PeriodReportModel.GainClass(r.NetProfit)">@r.NetProfit.ToString("C")</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Net cash movement</div>
            <div class="kpi-value @PortfolioManager.Web.Pages.Reports.PeriodReportModel.GainClass(r.TotalCashMovement)">@r.TotalCashMovement.ToString("C")</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100"><div class="card-body">
            <div class="text-muted small">Change in bank balances</div>
            <div class="kpi-value">@r.ChangeInBank.ToString("C")</div>
        </div></div>
    </div>
</div>

@if (r.Difference != 0)
{
    <div class="alert alert-warning">
        The cash movement and the change in the bank balances differ by @Math.Abs(r.Difference).ToString("C"), which usually means a journal
        in this period doesn't balance. The <a asp-page="/Accounting/TrialBalance">trial balance</a> shows whether the ledger balances overall.
    </div>
}

<partial name="_Statement" model="r.Lines" />

<h2 class="h5 mt-4">Bank transactions</h2>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th class="text-end">In</th>
                    <th class="text-end">Out</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transactions.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted p-4">No bank transactions in this period.</td></tr>
                }
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td class="text-nowrap">@t.Date.ToString("d MMM yyyy")</td>
                        <td>@t.Description</td>
                        <td class="small text-muted">@t.Category</td>
                        <td class="text-end text-success">@(t.Inflow != 0 ? t.Inflow.ToString("C") : "")</td>
                        <td class="text-end text-danger">@(t.Outflow != 0 ? t.Outflow.ToString("C") : "")</td>
                    </tr>
                }
            </tbody>
            @if (Model.Transactions.Count > 0)
            {
                <tfoot>
                    <tr class="table-active fw-bold">
                        <td colspan="3">Total</td>
                        <td class="text-end">@Model.Transactions.Sum(t => t.Inflow).ToString("C")</td>
                        <td class="text-end">@Model.Transactions.Sum(t => t.Outflow).ToString("C")</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
