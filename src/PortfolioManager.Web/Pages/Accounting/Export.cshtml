@page
@model ExportModel
@using PortfolioManager.Core.Exports
@{
    ViewData["Title"] = "Export to Xero or MYOB";
    var isXero = Model.System == ExportSystems.Xero;
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Export to Xero or MYOB</h1>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}

<ul class="nav nav-tabs mb-3">
    @foreach (var s in ExportSystems.All)
    {
        <li class="nav-item"><a class="nav-link @(s == Model.System ? "active" : "")" asp-route-system="@s" asp-route-shape="@Model.Shape" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")">@s</a></li>
    }
</ul>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5">Download</h2>
        <p class="text-muted small mb-3">
            @if (isXero)
            {
                <text>A CSV for Xero's <strong>Accounting, Manual journals, Import</strong>. Each journal's lines share a narration and date, debits are positive and credits negative.
                    Journals arrive in Xero as drafts for you to check and post.</text>
            }
            else
            {
                <text>A tab-delimited file for MYOB AccountRight's <strong>File, Import Data, General Journal Entries</strong>. Match the fields to the file's headings when MYOB asks.</text>
            }
            GST goes across as its own lines to the account you map the GST control account to, so @(isXero ? "Xero" : "MYOB") doesn't add it again.
        </p>
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" asp-for="System" />
            <input type="hidden" name="handler" value="Download" />
            <div class="col-md-5">
                <label asp-for="Shape" class="form-label small mb-1">What to send</label>
                <select asp-for="Shape" class="form-select form-select-sm">
                    @foreach (var s in new[] { ExportShapes.Journals, ExportShapes.Monthly, ExportShapes.Balances }) { <option value="@s">@ExportShapes.Label(s)</option> }
                </select>
            </div>
            <div class="col-auto"><label asp-for="From" class="form-label small mb-1">From</label><input asp-for="From" type="date" class="form-control form-control-sm" /></div>
            <div class="col-auto"><label asp-for="To" class="form-label small mb-1">To</label><input asp-for="To" type="date" class="form-control form-control-sm" /></div>
            <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-download"></i> Download</button></div>
        </form>
        <p class="small text-muted mt-2 mb-0">For opening balances (moving a client across), choose the balances option with the day before the first day in the new system.
            The "From" date is ignored then. Map the income and expense accounts to retained earnings, or the year's profit lands in them.</p>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5">Send straight to @Model.System</h2>
        @if (!Model.CanConnect)
        {
            <p class="text-muted small mb-0">This copy of the site hasn't been registered with @Model.System, so use the download above. Whoever hosts the site can
                register it (see SETUP.md, "Sending to Xero and MYOB") and then every portfolio can connect to its own @(isXero ? "organisation" : "company file").</p>
        }
        else if (Model.Connection is not { } c)
        {
            <p class="text-muted small">Connect this portfolio to its @(isXero ? "Xero organisation" : "MYOB business") once, then send the same journals as the
                download without saving and importing a file. You sign in at @Model.System and choose the @(isXero ? "organisation" : "business"); this site keeps
                only an encrypted sign-in it can renew, and can disconnect at any time.</p>
            <form method="post" asp-page-handler="Connect">
                <input type="hidden" asp-for="System" />
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-plug"></i> Connect to @Model.System</button>
            </form>
        }
        else
        {
            <p class="small mb-2">Connected to <strong>@(c.OrganisationName ?? c.OrganisationId)</strong> on @c.Connected.ToString("d")@(c.ConnectedBy is { } by ? $" by {by}" : "").
                @(isXero ? "Journals arrive as drafts to check and post." : "Journals are recorded in MYOB straight away.")</p>
            <form method="post" asp-page-handler="Send" class="row g-2 align-items-end">
                <input type="hidden" asp-for="System" />
                <div class="col-md-5">
                    <label class="form-label small mb-1" for="sendShape">What to send</label>
                    <select id="sendShape" name="Shape" class="form-select form-select-sm">
                        @foreach (var s in new[] { ExportShapes.Journals, ExportShapes.Monthly, ExportShapes.Balances }) { <option value="@s" selected="@(s == Model.Shape)">@ExportShapes.Label(s)</option> }
                    </select>
                </div>
                <div class="col-auto"><label class="form-label small mb-1" for="sendFrom">From</label><input id="sendFrom" name="From" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
                <div class="col-auto"><label class="form-label small mb-1" for="sendTo">To</label><input id="sendTo" name="To" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
                <div class="col-auto form-check ms-2 mb-1"><input class="form-check-input" type="checkbox" name="again" value="true" id="again" /><label class="form-check-label small" for="again">Send again anyway</label></div>
                <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-send"></i> Send to @Model.System</button></div>
            </form>
            <form method="post" asp-page-handler="Disconnect" class="mt-2" data-confirm="Disconnect this portfolio from @Model.System?" onsubmit="return confirm(this.dataset.confirm);">
                <input type="hidden" asp-for="System" />
                <button type="submit" class="btn btn-sm btn-link text-danger p-0">Disconnect</button>
            </form>
            @if (Model.Sends.Count > 0)
            {
                <table class="table table-sm small mt-3 mb-0">
                    <thead><tr><th>Sent</th><th>What</th><th>Dates</th><th class="text-end">Journals</th><th>Result</th></tr></thead>
                    <tbody>
                        @foreach (var x in Model.Sends)
                        {
                            <tr>
                                <td class="text-nowrap">@x.SentAt.ToString("g")@(x.SentBy is { } who ? $" ({who})" : "")</td>
                                <td>@ExportShapes.Label(x.Shape)</td>
                                <td class="text-nowrap">@(x.From is { } f ? f.ToString("d") + " to " : "to ")@x.To.ToString("d")</td>
                                <td class="text-end">@x.Sent of @x.Journals</td>
                                <td>@(x.Result ?? "Sent")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>

<form method="post" asp-page-handler="Map">
    <input type="hidden" asp-for="System" />
    <input type="hidden" asp-for="Shape" />
    <input type="hidden" asp-for="From" />
    <input type="hidden" asp-for="To" />
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold">Account codes in @Model.System</span>
            <button type="submit" class="btn btn-sm btn-success">Save codes</button>
        </div>
        <div class="card-body pb-0"><p class="small text-muted">Blank: the account goes out under its number here. Several accounts can share one code; their amounts are added together.
            Tax: @(isXero ? "the Xero tax rate name, such as BAS Excluded or GST Free Income" : "the MYOB tax code, such as N-T or FRE") (blank: @ExportSystems.DefaultTax(Model.System)).</p></div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Account here</th><th>Type</th><th style="width: 12rem">@Model.System code</th><th style="width: 14rem">Tax</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Model.Accounts.Count; i++)
                    {
                        var a = Model.Accounts[i];
                        var m = Model.Current.GetValueOrDefault(a.AccountId);
                        <tr>
                            <td>@a.Display<input type="hidden" name="Map[@i].AccountId" value="@a.AccountId" /></td>
                            <td class="small text-muted">@a.Type</td>
                            <td><input name="Map[@i].Code" value="@m?.Code" maxlength="30" class="form-control form-control-sm" placeholder="@a.Number" /></td>
                            <td><input name="Map[@i].Tax" value="@m?.TaxCode" maxlength="50" class="form-control form-control-sm" placeholder="@ExportSystems.DefaultTax(Model.System)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</form>
