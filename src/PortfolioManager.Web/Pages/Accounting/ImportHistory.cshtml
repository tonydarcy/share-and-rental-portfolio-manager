@page
@model ImportHistoryModel
@{
    ViewData["Title"] = "Import history";
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Import history</h1>
    <div class="d-flex gap-2">
        <a asp-page="/Accounting/BankImport" class="btn btn-sm btn-primary"><i class="bi bi-upload"></i> Import a statement</a>
        <a asp-page="/Accounting/Unallocated" class="btn btn-sm btn-outline-secondary">Unallocated transactions</a>
    </div>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Imported</th>
                    <th class="text-end">Transactions</th>
                    <th class="text-end">Total value</th>
                    <th style="min-width: 12rem">Allocated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Batches.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted p-4">No bank statements have been imported into this portfolio.</td></tr>
                }
                @foreach (var b in Model.Batches)
                {
                    <tr>
                        <td class="text-nowrap">@b.ImportedOn?.ToString("d MMM yyyy h:mm tt")</td>
                        <td class="text-end">@b.Transactions</td>
                        <td class="text-end">@b.TotalValue.ToString("C")</td>
                        <td>
                            @if (b.Allocated == 0)
                            {
                                <span class="badge text-bg-warning">Not allocated</span>
                            }
                            else if (b.FullyAllocated)
                            {
                                <span class="badge text-bg-success">Fully allocated</span>
                            }
                            else
                            {
                                <div class="progress" style="height: 0.5rem" role="progressbar" aria-valuenow="@b.Percent" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-success" style="width: @b.Percent%"></div>
                                </div>
                                <small class="text-muted">@b.Allocated of @b.Transactions allocated</small>
                            }
                        </td>
                        <td class="text-end">
                            @if (b.Locked)
                            {
                                <span class="badge text-bg-light border" title="Some of this import is allocated, so it can't be deleted"><i class="bi bi-lock-fill"></i> Locked</span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Delete" asp-route-batchId="@b.BatchId" class="d-inline"
                                      data-confirm="Delete the @b.Transactions transactions imported on @b.ImportedOn?.ToString("d MMM yyyy")?"
                                      onsubmit="return confirm(this.dataset.confirm);">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete this import"><i class="bi bi-trash"></i> Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="text-muted small mt-2">
    An import can be deleted, with all its transactions, until any of them is allocated.
</p>
