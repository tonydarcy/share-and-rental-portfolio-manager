@page
@model TrackingReportModel
@{
    ViewData["Title"] = "Profit & loss by tracking";
    var r = Model.Report;
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom gap-2">
    <h1 class="h2 mb-0">Profit &amp; loss by tracking</h1>
    <a asp-page="/Accounting/Tracking" class="btn btn-sm btn-outline-secondary">Tracking categories</a>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}
@if (r is null)
{
    <div class="alert alert-info">Set up a <a asp-page="/Accounting/Tracking">tracking category</a> first, then tag invoice, bill and journal lines with its options.</div>
    return;
}

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small" for="position">Category</label>
        <select id="position" name="position" class="form-select form-select-sm">
            @foreach (var c in Model.Setup.Categories) { <option value="@c.Position" selected="@(c.Position == Model.Position)">@c.Name</option> }
        </select>
    </div>
    <div class="col-auto"><label class="form-label small" for="from">From</label><input type="date" id="from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
    <div class="col-auto"><label class="form-label small" for="to">To</label><input type="date" id="to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
    <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-primary">Show</button></div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Account</th>
                    @foreach (var col in r.Columns) { <th class="text-end">@(col is null ? "Not tagged" : Model.Setup.OptionName(col))</th> }
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (type, heading) in new[] { ("Revenue", "Income"), ("Expense", "Expenses") })
                {
                    <tr class="table-light"><th colspan="@(r.Columns.Count + 2)">@heading</th></tr>
                    @foreach (var a in r.Accounts(type))
                    {
                        <tr>
                            <td>@a.Number - @a.Name</td>
                            @foreach (var col in r.Columns) { <td class="text-end">@(r.Amount(a.AccountId, col) is var v && v != 0 ? v.ToString("C") : "")</td> }
                            <td class="text-end fw-semibold">@r.Columns.Sum(c => r.Amount(a.AccountId, c)).ToString("C")</td>
                        </tr>
                    }
                    <tr class="fw-semibold">
                        <td>Total @heading.ToLowerInvariant()</td>
                        @foreach (var col in r.Columns) { <td class="text-end">@r.Total(type, col).ToString("C")</td> }
                        <td class="text-end">@r.Columns.Sum(c => r.Total(type, c)).ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold">
                    <td>Profit (loss)</td>
                    @foreach (var col in r.Columns) { <td class="text-end">@r.Profit(col).ToString("C")</td> }
                    <td class="text-end">@r.Columns.Sum(c => r.Profit(c)).ToString("C")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
