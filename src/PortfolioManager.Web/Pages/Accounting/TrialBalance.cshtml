@page
@model TrialBalanceModel
@{
    ViewData["Title"] = "Trial balance";
    var r = Model.Report;
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <div>
        <h1 class="h2 mb-0">Trial balance</h1>
        @if (Model.Portfolio is not null)
        {
            <div class="text-muted">@Model.Portfolio.Name &middot; as at @Model.Date.ToString("d MMMM yyyy")</div>
        }
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary no-print" onclick="window.print()"><i class="bi bi-printer"></i> Print / PDF</button>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}

<partial name="_ModeNotice" model="Model.Mode" />
<p class="text-muted small no-print">Total debits and credits posted to each account up to the date below. The two totals should agree.</p>
<partial name="_AsAtFilter" model="Model" />

@if (r.Lines.Count > 0)
{
    if (r.Balances)
    {
        <div class="alert alert-success py-2"><i class="bi bi-check-circle"></i> The ledger balances: debits and credits are both @r.TotalDebit.ToString("C").</div>
    }
    else
    {
        <div class="alert alert-warning py-2">
            Debits and credits differ by @Math.Abs(r.Difference).ToString("C"). Some journals don't balance; run
            Database/Migrations/2026-10-15-check-unbalanced-journals.sql to list them.
        </div>
    }
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 6rem">Account</th>
                    <th></th>
                    <th class="text-end">Debit</th>
                    <th class="text-end">Credit</th>
                </tr>
            </thead>
            <tbody>
                @if (r.Lines.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted p-4">Nothing has been posted to the ledger yet.</td></tr>
                }
                @foreach (var l in r.Lines)
                {
                    var css = l.IsHeader ? "table-light fw-bold text-uppercase text-secondary small"
                        : l.IsGrandTotal ? "table-dark fw-bold"
                        : l.IsTotal ? "table-active fw-bold"
                        : "";
                    <tr class="@css">
                        <td>@(l.IsHeader || l.IsTotal || l.IsGrandTotal ? "" : l.AccountNumber?.ToString())</td>
                        <td class="@(l.RowType == "Item" ? "ps-4" : "")">@l.AccountName</td>
                        <td class="text-end text-nowrap">@(l.IsHeader ? "" : (l.Debit ?? 0).ToString("C"))</td>
                        <td class="text-end text-nowrap">@(l.IsHeader ? "" : (l.Credit ?? 0).ToString("C"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="text-muted small mt-2">
    Net profit / (loss) is shown for information; the trial balance total adds up the accounts only.
</p>
