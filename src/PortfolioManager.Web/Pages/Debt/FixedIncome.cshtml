@page
@model PortfolioManager.Web.Pages.Debt.FixedIncomeModel
@using PortfolioManager.Core.Debt
@using PortfolioManager.Core.Tax
@{
    ViewData["Title"] = "Term deposits and bonds";
    var i = Model.Input;
    var end = FinancialYear.EndDate(Model.Year);
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Term deposits, bonds and hybrids</h1>
    <button type="button" class="btn btn-sm btn-outline-secondary no-print" onclick="window.print()"><i class="bi bi-printer"></i> Print / PDF</button>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}
@if (Model.Message is not null)
{
    <div class="alert alert-info">@Model.Message</div>
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

<p class="text-muted">Enter each term deposit, bond or hybrid. The page works out the interest earned in the financial year and the interest built
    up but not yet paid at its end, on simple interest (actual days over 365). Record the interest when it's paid as a payout as usual; the
    accrued figure is for accounts kept on an accruals basis (a company or a fund), as a year-end adjustment. Listed bonds and hybrids bought
    on the market are also share trades, for their price.</p>

<form method="get" class="mb-2 no-print">
    <label for="fy" class="form-label small text-muted mb-1">Financial year</label>
    <select id="fy" name="fy" class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.submit()">
        @foreach (var y in Model.Years) { <option value="@y" selected="@(y == Model.Year)">@FinancialYear.Label(y)</option> }
    </select>
</form>
<div class="card shadow-sm mb-3">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Investment</th><th class="text-end">Amount</th><th class="text-end">Rate</th><th>Start</th><th>Maturity</th><th>Interest paid</th>
                    <th class="text-end">Earned in the year</th><th class="text-end">Accrued at @end.ToString("d MMM yyyy")</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted p-4">None yet.</td></tr>
                }
                @foreach (var r in Model.Rows)
                {
                    var h = r.Holding;
                    <tr>
                        <td><span class="fw-bold">@h.Name</span> <span class="small text-muted">@FixedIncomeKinds.Text(h.Kind)@(h.StockCode is null ? "" : $", {h.StockCode}")</span></td>
                        <td class="text-end">@h.FaceValue.ToString("C")</td>
                        <td class="text-end">@h.RatePercent.ToString("0.###")%</td>
                        <td>@h.Start.ToString("d MMM yyyy")</td>
                        <td>@(h.Maturity?.ToString("d MMM yyyy") ?? "None")</td>
                        <td>@InterestFrequency.Text(h.Frequency)@(r.NextPayment is { } n ? $", next {n:d MMM yyyy}" : "")</td>
                        <td class="text-end">@r.Earned.ToString("C")</td>
                        <td class="text-end fw-bold">@r.AccruedAtEnd.ToString("C")</td>
                        <td class="text-end text-nowrap no-print">
                            <a class="btn btn-sm btn-outline-secondary" asp-route-edit="@h.Id" asp-route-fy="@Model.Year">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@h.Id" asp-route-fy="@Model.Year" class="d-inline"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
                        </td>
                    </tr>
                }
            </tbody>
            @if (Model.Rows.Count > 0)
            {
                <tfoot><tr class="table-active fw-bold"><td colspan="6">Total</td><td class="text-end">@Model.Rows.Sum(r => r.Earned).ToString("C")</td>
                    <td class="text-end">@Model.Rows.Sum(r => r.AccruedAtEnd).ToString("C")</td><td></td></tr></tfoot>
            }
        </table>
    </div>
</div>

<form method="post" asp-page-handler="Save" asp-route-fy="@Model.Year" class="card shadow-sm no-print">
    <div class="card-body">
        <h2 class="h6">@(i.Id == 0 ? "Add one" : "Change it")</h2>
        <input type="hidden" asp-for="Input.Id" />
        <div class="row g-2">
            <div class="col-sm-6 col-md-3"><label class="form-label small mb-0" asp-for="Input.Kind">Type</label>
                <select class="form-select" asp-for="Input.Kind">@foreach (var k in FixedIncomeKinds.All) { <option value="@k">@FixedIncomeKinds.Text(k)</option> }</select></div>
            <div class="col-sm-6 col-md-5"><label class="form-label small mb-0" asp-for="Input.Name">Name</label><input class="form-control" asp-for="Input.Name" maxlength="200" placeholder="e.g. ANZ 12 month term deposit" /></div>
            <div class="col-sm-3 col-md-2"><label class="form-label small mb-0" asp-for="Input.ExchangeCode">Exchange <span class="text-muted">(listed)</span></label><input class="form-control text-uppercase" asp-for="Input.ExchangeCode" maxlength="50" /></div>
            <div class="col-sm-3 col-md-2"><label class="form-label small mb-0" asp-for="Input.StockCode">Code <span class="text-muted">(listed)</span></label><input class="form-control text-uppercase" asp-for="Input.StockCode" maxlength="50" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label small mb-0" asp-for="Input.FaceValue">Amount (face value)</label><input class="form-control" asp-for="Input.FaceValue" type="number" step="0.01" min="0" /></div>
            <div class="col-sm-6 col-md-2"><label class="form-label small mb-0" asp-for="Input.RatePercent">Rate a year, %</label><input class="form-control" asp-for="Input.RatePercent" type="number" step="any" min="0" /></div>
            <div class="col-sm-6 col-md-2"><label class="form-label small mb-0" asp-for="Input.Start">Start</label><input class="form-control" asp-for="Input.Start" type="date" asp-format="{0:yyyy-MM-dd}" /></div>
            <div class="col-sm-6 col-md-2"><label class="form-label small mb-0" asp-for="Input.Maturity">Maturity</label><input class="form-control" asp-for="Input.Maturity" type="date" asp-format="{0:yyyy-MM-dd}" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label small mb-0" asp-for="Input.Frequency">Interest paid</label>
                <select class="form-select" asp-for="Input.Frequency">@foreach (var f in InterestFrequency.All) { <option value="@f">@InterestFrequency.Text(f)</option> }</select></div>
            <div class="col-12"><label class="form-label small mb-0" asp-for="Input.Comment">Note</label><input class="form-control" asp-for="Input.Comment" maxlength="500" /></div>
        </div>
        <button class="btn btn-primary mt-3">Save</button>
        @if (i.Id != 0) { <a class="btn btn-link mt-3" asp-page="./FixedIncome">Cancel</a> }
    </div>
</form>
