@page "{id:int}"
@model PortfolioManager.Web.Pages.Groups.EditModel
@{
    ViewData["Title"] = "Edit group";
    var byStock = Model.Trades.GroupBy(t => $"{t.ExchangeCode.Trim()}:{t.StockCode.Trim()}").OrderBy(g => g.Key).ToList();
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Edit group</h1>
    <a asp-page="Index" class="btn btn-sm btn-outline-secondary">All groups</a>
</div>

<form method="post">
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Group name</label>
                    <input asp-for="Name" class="form-control" maxlength="100" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6 text-md-end">
                    <button type="submit" class="btn btn-primary">Save group</button>
                </div>
            </div>
        </div>
    </div>

    @if (byStock.Count == 0)
    {
        <div class="alert alert-info">This portfolio has no trades yet.</div>
    }
    else
    {
        <p class="text-muted small">Tick the trades that belong in this group. Ticking a stock's name ticks all its trades.</p>
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th style="width:2.5rem"></th><th>Date</th><th>Type</th><th class="text-end">Units</th><th class="text-end">Price</th><th class="text-end">Total</th></tr>
                    </thead>
                    @foreach (var stock in byStock)
                    {
                        var stockId = "s" + stock.Key.Replace(":", "_").Replace(".", "_");
                        <tbody>
                            <tr class="table-active">
                                <td><input type="checkbox" class="form-check-input stock-toggle" data-stock="@stockId" id="@stockId"
                                           checked="@stock.All(t => Model.InGroup.Contains(t.TradeId))" /></td>
                                <td colspan="5"><label for="@stockId" class="fw-semibold">@stock.Key</label> <span class="text-muted small">@stock.First().Name</span></td>
                            </tr>
                            @foreach (var t in stock)
                            {
                                <tr>
                                    <td><input type="checkbox" class="form-check-input trade-box @stockId" name="Ticked" value="@t.TradeId"
                                               id="t@(t.TradeId)" checked="@Model.InGroup.Contains(t.TradeId)" /></td>
                                    <td><label for="t@(t.TradeId)">@t.Date.ToString("d MMM yyyy")</label></td>
                                    <td>@t.Type</td>
                                    <td class="text-end">@t.Quantity.ToString("N0")</td>
                                    <td class="text-end">@t.PricePerUnit.ToString("N3")</td>
                                    <td class="text-end">@t.OrderTotal.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
            </div>
        </div>
        <button type="submit" class="btn btn-primary mt-3">Save group</button>
    }
</form>

@section Scripts {
    <script>
        for (const toggle of document.querySelectorAll('.stock-toggle')) {
            toggle.addEventListener('change', () => {
                for (const box of document.querySelectorAll('.trade-box.' + toggle.dataset.stock)) box.checked = toggle.checked;
            });
        }
    </script>
}
