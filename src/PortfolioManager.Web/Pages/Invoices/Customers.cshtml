@page
@model CustomersModel
@{
    ViewData["Title"] = "Customers";
    var editing = Model.Id is not null;
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Customers</h1>
    <a asp-page="/Invoices/Index" class="btn btn-sm btn-outline-secondary">Back to invoices</a>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light"><tr><th>Name</th><th>Email</th><th class="text-end">Invoices</th><th class="text-end">Owing</th><th></th></tr></thead>
                    <tbody>
                        @if (Model.Customers.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted p-4">No customers yet.</td></tr>
                        }
                        @foreach (var c in Model.Customers)
                        {
                            <tr class="@(c.IsActive ? "" : "text-muted")">
                                <td>@c.Name @if (!c.IsActive) { <span class="badge text-bg-light">Inactive</span> }</td>
                                <td class="small">@c.Email</td>
                                <td class="text-end">@c.InvoiceCount</td>
                                <td class="text-end">@(c.Outstanding != 0 ? c.Outstanding.ToString("C") : "")</td>
                                <td class="text-end text-nowrap">
                                    <a asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    @if (c.InvoiceCount == 0 && Model.Portfolio.CanEdit)
                                    {
                                        <form method="post" asp-page-handler="Delete" asp-route-customerId="@c.CustomerId" class="d-inline"
                                              data-confirm="Delete @c.Name?" onsubmit="return confirm(this.dataset.confirm);">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <form method="post" asp-page-handler="Save" asp-route-id="@Model.Id" asp-route-returnTo="@Model.ReturnTo" class="card shadow-sm">
            <fieldset class="card-body" disabled="@(!Model.Portfolio.CanEdit)">
                <h2 class="h6">@(editing ? "Edit customer" : "Add a customer")</h2>
                <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                <div class="mb-2">
                    <label asp-for="Input.Name" class="form-label">Name</label>
                    <input asp-for="Input.Name" class="form-control" maxlength="200" required />
                </div>
                <div class="mb-2">
                    <label asp-for="Input.ContactName" class="form-label">Contact person (optional)</label>
                    <input asp-for="Input.ContactName" class="form-control" maxlength="200" />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-sm-7">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" type="email" class="form-control" maxlength="500" />
                    </div>
                    <div class="col-sm-5">
                        <label asp-for="Input.Phone" class="form-label">Phone</label>
                        <input asp-for="Input.Phone" class="form-control" maxlength="50" />
                    </div>
                </div>
                <div class="mb-2">
                    <label asp-for="Input.Address" class="form-label">Address</label>
                    <textarea asp-for="Input.Address" class="form-control" rows="3" maxlength="500"></textarea>
                </div>
                <div class="mb-2">
                    <label asp-for="Input.TaxNumber" class="form-label">Business or tax number (ABN, VAT number)</label>
                    <input asp-for="Input.TaxNumber" class="form-control" maxlength="50" />
                </div>
                @if (editing)
                {
                    <div class="form-check mb-2">
                        <input asp-for="Input.IsActive" class="form-check-input" />
                        <label asp-for="Input.IsActive" class="form-check-label">Active (shows when raising an invoice)</label>
                    </div>
                }
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@(editing ? "Save customer" : "Add customer")</button>
                    @if (editing)
                    {
                        <a asp-route-id="" class="btn btn-outline-secondary">Cancel</a>
                    }
                </div>
            </fieldset>
        </form>
    </div>
</div>
