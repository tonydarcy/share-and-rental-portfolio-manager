@page
@model RepeatingModel
@{
    ViewData["Title"] = "Repeating invoices";
    var due = Model.Items.Sum(r => r.DueDates(Model.Today).Count);
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Repeating invoices</h1>
    <a asp-page="/Invoices/Index" class="btn btn-sm btn-outline-secondary">All invoices</a>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}

<p class="text-muted">To set one up, open an approved invoice and press <strong>Repeat</strong>. Each date due up to today becomes its own invoice when you press
    <em>Create what's due</em>, as a draft or approved and posted, as chosen.</p>

<form method="post" asp-page-handler="CreateDue" class="mb-3">
    <button type="submit" class="btn btn-success" disabled="@(due == 0)"><i class="bi bi-play-fill"></i> Create what's due (@due)</button>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Customer</th><th>How often</th><th class="text-end">Amount</th><th>Next</th><th>Last made</th><th></th></tr></thead>
            <tbody>
                @if (Model.Items.Count == 0) { <tr><td colspan="7" class="text-center text-muted p-4">No repeating invoices yet.</td></tr> }
                @foreach (var r in Model.Items)
                {
                    var n = r.DueDates(Model.Today).Count;
                    <tr class="@(r.Active ? "" : "text-muted")">
                        <td><span class="fw-bold">@r.Name</span> @if (!r.Active) { <span class="badge text-bg-secondary">paused</span> }
                            <div class="small text-muted">@(r.Approve ? "Approved when made" : "Made as drafts")</div></td>
                        <td>@r.CustomerName</td>
                        <td>@RepeatFrequencies.Label(r.Frequency)@(r.End is { } e ? $" until {e:d}" : "")</td>
                        <td class="text-end">@r.Lines.Sum(l => (l.Quantity ?? 1) * (l.UnitPrice ?? 0)).ToString("C")</td>
                        <td class="text-nowrap">@r.NextDate.ToString("d") @if (n > 0) { <span class="badge text-bg-warning">@n due</span> }</td>
                        <td>@(r.LastCreated?.ToString("d") ?? "Not yet")</td>
                        <td class="text-end text-nowrap">
                            <form method="post" asp-page-handler="Active" asp-route-id="@r.Id" asp-route-active="@(!r.Active)" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(r.Active ? "Pause" : "Start again")</button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" class="d-inline" onsubmit="return confirm('Stop this invoice repeating?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
