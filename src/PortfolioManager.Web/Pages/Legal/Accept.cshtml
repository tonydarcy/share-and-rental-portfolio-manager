@page
@model PortfolioManager.Web.Pages.Legal.AcceptModel
@{
    ViewData["Title"] = "Terms of use";
}

<div class="col-lg-7">
    <h1 class="h2 pb-2 mb-3 border-bottom">@(Model.Updated ? "Our terms have changed" : "Before you carry on")</h1>
    <p>
        @(Model.Updated ? "We've updated our terms of use and privacy policy." : "Please read and agree to our terms of use and privacy policy.")
        In short: the site keeps your records and works out figures from them, but it isn't financial or tax advice,
        figures can contain errors so check them before you lodge or rely on them, and our liability is limited as far as
        the law allows. Your rights under the Australian Consumer Law are not affected.
    </p>
    <ul>
        <li><a href="@(Model.TermsUrl ?? Url.Page("/Legal/Terms"))" target="_blank" rel="noopener">Terms of use</a></li>
        <li><a href="@(Model.PrivacyUrl ?? Url.Page("/Legal/Privacy"))" target="_blank" rel="noopener">Privacy policy</a></li>
    </ul>
    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-check mb-3">
            <input asp-for="Agree" class="form-check-input" />
            <label asp-for="Agree" class="form-check-label">I agree to the terms of use and privacy policy</label>
        </div>
        <button type="submit" class="btn btn-primary">Carry on</button>
    </form>
    <form method="post" asp-page="/Account/Logout" class="mt-3">
        <button type="submit" class="btn btn-link px-0">Log out instead</button>
    </form>
</div>
