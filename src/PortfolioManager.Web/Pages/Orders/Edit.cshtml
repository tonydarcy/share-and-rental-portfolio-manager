@page
@model EditModel
@{
    var word = Model.IsQuote ? "quote" : "purchase order";
    ViewData["Title"] = Model.Existing is { } e ? $"Edit {word} {e.Number}" : $"New {word}";
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">@ViewData["Title"]</h1>
    <a asp-page="@(Model.Id is null ? "/Orders/Index" : "/Orders/View")" asp-route-id="@Model.Id" asp-route-kind="@Model.Kind" class="btn btn-sm btn-outline-secondary">Cancel</a>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}
@if (Model.Contacts.Count == 0)
{
    <div class="alert alert-info">
        @if (Model.IsQuote) { <text>Add a customer first: <a asp-page="/Invoices/Customers">add a customer</a>.</text> }
        else { <text>Add a supplier first: <a asp-page="/Bills/Suppliers">add a supplier</a>.</text> }
    </div>
    return;
}

<form method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Input.Kind" />
    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Input.ContactId" class="form-label">@(Model.IsQuote ? "Customer" : "Supplier")</label>
                    <select asp-for="Input.ContactId" class="form-select" required>
                        <option value="0">-- Choose --</option>
                        @foreach (var c in Model.Contacts) { <option value="@c.Id">@c.Name</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Title" class="form-label">Title (optional)</label>
                    <input asp-for="Input.Title" class="form-control" maxlength="200" placeholder="@(Model.IsQuote ? "e.g. Kitchen renovation" : "e.g. Stock for March")" />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label asp-for="Input.Date" class="form-label">Date</label>
                    <input asp-for="Input.Date" type="date" class="form-control" required />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label asp-for="Input.Expiry" class="form-label">@(Model.IsQuote ? "Expires" : "Delivery date")</label>
                    <input asp-for="Input.Expiry" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Reference" class="form-label">Reference (optional)</label>
                    <input asp-for="Input.Reference" class="form-control" maxlength="200" />
                </div>
            </div>
            @if (Model.Lists.TaxCodes.Count > 0)
            {
                <div class="form-check mt-3">
                    <input asp-for="Input.AmountsIncludeTax" class="form-check-input" id="includesTax" />
                    <label asp-for="Input.AmountsIncludeTax" class="form-check-label" for="includesTax">Prices include @Model.Lists.TaxName</label>
                </div>
            }
            <partial name="_CurrencyFields" model="new CurrencyFieldsView(Model.Input.Currency, Model.Input.ExchangeRate, RegionSettings.Current.Currency)" />
        </div>
    </div>

    <partial name="_DocumentLines" model="Model.Lists.View(Model.Input.Lines)" />

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <label asp-for="Input.Notes" class="form-label">@(Model.IsQuote ? "Terms and notes on the quote" : "Delivery address and notes")</label>
            <textarea asp-for="Input.Notes" class="form-control" rows="3" maxlength="2000"></textarea>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <p class="text-muted small mt-2">Saving posts nothing to the ledger. Blank lines are ignored.</p>
</form>

@section Scripts {
    <script src="~/js/document-lines.js" asp-append-version="true"></script>
}
