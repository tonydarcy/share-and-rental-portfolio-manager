@page
@model PortfolioManager.Web.Pages.Payouts.AddRentalModel
@{
    ViewData["Title"] = "Add rental payout";
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Add a rental payout</h1>
    <a asp-page="/Payouts/Index" class="btn btn-sm btn-outline-secondary">Back to payouts</a>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}

<div class="card shadow-sm">
    <div class="card-body">
        <p class="text-muted">Rent and property expenses for <strong>@Model.Portfolio.Name</strong>, e.g. from an agent's statement. Enter expenses as positive amounts.</p>
        <form method="post">
            <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
            @if (Model.Properties.Count > 0)
            {
                <div class="mb-3" style="max-width: 32rem">
                    <label for="pickProperty" class="form-label">Which property</label>
                    <select id="pickProperty" class="form-select" onchange="if (this.value) document.getElementById('Input_PropertyCode').value = this.value;">
                        <option value="">Choose a property to fill in its code</option>
                        @foreach (var p in Model.Properties.Where(p => p.Active))
                        {
                            <option value="@p.PayoutCode" disabled="@(p.PayoutCode is null)" selected="@(p.PayoutCode is not null && p.PayoutCode == Model.Input.PropertyCode)">@p.Address@(p.PayoutCode is null ? " (set its agent statement code on the property page first)" : $" ({p.PayoutCode})")</option>
                        }
                    </select>
                    <div class="form-text">Payouts with a property's code go onto its rental schedule automatically.</div>
                </div>
            }
            <partial name="_RentalFields" for="Input" />
            <button type="submit" class="btn btn-success">Save rental payout</button>
        </form>
    </div>
</div>
