@page
@model PortfolioManager.Web.Pages.Payouts.EmployeeSharesModel
@using PortfolioManager.Core.Tax
@{
    ViewData["Title"] = "Employee share schemes";
    var i = Model.Input;
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Employee share schemes</h1>
    <span class="text-muted">ESS statements</span>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}
@if (Model.Success is not null)
{
    <div class="alert alert-success">@Model.Success</div>
}

<p class="text-muted">Enter the discounts from each employer's employee share scheme (ESS) statement once the year is over. They go on the
    return labels at item 12 of an individual's return. The shares or rights themselves are holdings: add them on
    <a asp-page="/Trades/Add">Share trades</a> as a purchase at their market value on the taxing point (that's their cost base, and the
    date they were acquired). Exercising rights or options is on <a asp-page="/CorporateActions/AddTransfer" asp-route-kind="OptionExercise">Corporate actions</a>.</p>

<div class="card shadow-sm mb-3">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Year</th><th>Employer</th><th class="text-end">Upfront (D + E)</th><th class="text-end">Deferral (F)</th>
                    <th class="text-end">Before July 2009 (G)</th><th class="text-end">TFN withheld (C)</th><th></th></tr>
            </thead>
            <tbody>
                @if (Model.Statements.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted p-4">No statements yet.</td></tr>
                }
                @foreach (var s in Model.Statements)
                {
                    <tr>
                        <td>@FinancialYear.Label(s.Year)</td>
                        <td>@s.Employer</td>
                        <td class="text-end">@((s.UpfrontEligible + s.UpfrontNotEligible).ToString("C"))</td>
                        <td class="text-end">@s.Deferral.ToString("C")</td>
                        <td class="text-end">@s.Pre2009.ToString("C")</td>
                        <td class="text-end">@s.TfnWithheld.ToString("C")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-route-edit="@s.Id">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<form method="post" asp-page-handler="Save" class="card shadow-sm">
    <div class="card-body">
        <h2 class="h6">@(i.Id == 0 ? "Add a statement" : "Change the statement")</h2>
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="row g-2">
            <div class="col-sm-6 col-md-5"><label class="form-label" asp-for="Input.Employer">Employer</label>
                <input class="form-control" asp-for="Input.Employer" maxlength="200" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label" asp-for="Input.Year">Financial year</label>
                <select class="form-select" asp-for="Input.Year">
                    @foreach (var y in Model.Years) { <option value="@y">@FinancialYear.Label(y)</option> }
                </select></div>
        </div>
        <div class="row g-2 mt-1">
            <div class="col-sm-6 col-md-4"><label class="form-label small mb-0" asp-for="Input.UpfrontEligible">Taxed upfront, eligible for reduction (D)</label>
                <input class="form-control" asp-for="Input.UpfrontEligible" type="number" step="0.01" min="0" /></div>
            <div class="col-sm-6 col-md-4"><label class="form-label small mb-0" asp-for="Input.UpfrontNotEligible">Taxed upfront, not eligible (E)</label>
                <input class="form-control" asp-for="Input.UpfrontNotEligible" type="number" step="0.01" min="0" /></div>
            <div class="col-sm-6 col-md-4"><label class="form-label small mb-0" asp-for="Input.Deferral">Deferral schemes (F)</label>
                <input class="form-control" asp-for="Input.Deferral" type="number" step="0.01" min="0" /></div>
            <div class="col-sm-6 col-md-4"><label class="form-label small mb-0" asp-for="Input.Pre2009">Acquired before 1 July 2009, cessation this year (G)</label>
                <input class="form-control" asp-for="Input.Pre2009" type="number" step="0.01" min="0" /></div>
            <div class="col-sm-6 col-md-4"><label class="form-label small mb-0" asp-for="Input.ForeignSource">Foreign source part of the discounts (A)</label>
                <input class="form-control" asp-for="Input.ForeignSource" type="number" step="0.01" min="0" /></div>
            <div class="col-sm-6 col-md-4"><label class="form-label small mb-0" asp-for="Input.TfnWithheld">TFN amounts withheld (C)</label>
                <input class="form-control" asp-for="Input.TfnWithheld" type="number" step="0.01" min="0" /></div>
        </div>
        <div class="mt-3" style="max-width: 40rem"><label class="form-label" asp-for="Input.Comment">Note</label><input class="form-control" asp-for="Input.Comment" maxlength="500" /></div>
        <div class="mt-3">
            <button class="btn btn-primary">Save</button>
            @if (i.Id != 0) { <a class="btn btn-link" asp-page="./EmployeeShares">Cancel</a> }
        </div>
        <p class="small text-muted mt-2 mb-0">The $1,000 reduction for taxed upfront discounts (D) applies only when the income test is met; the return labels
            show the discount before it.</p>
    </div>
</form>
