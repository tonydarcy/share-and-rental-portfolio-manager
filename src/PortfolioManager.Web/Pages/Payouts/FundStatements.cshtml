@page
@model PortfolioManager.Web.Pages.Payouts.FundStatementsModel
@using PortfolioManager.Core.Tax
@{
    ViewData["Title"] = "Fund tax statements";
    var i = Model.Input;
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Fund tax statements</h1>
    <span class="text-muted">AMMA and annual distribution statements</span>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}
@if (Model.Success is not null)
{
    <div class="alert alert-success">@Model.Success</div>
}

<p class="text-muted">Enter each ETF's or managed fund's annual tax statement once the year is over. For that fund and year, the
    tax workpapers and return labels use the statement's figures instead of the payouts' breakdown; its capital gains go into
    the capital gains report (discount method gains are grossed up, so your own discount applies); and its cost base increase
    or decrease changes the cost base of the units held at the year end. In a Hybrid or double-entry portfolio the cost base change
    is also posted to the ledger at the year end, between Trust Distribution Income and the fund's cost base account.</p>

<form method="post" asp-page-handler="Preview" enctype="multipart/form-data" class="card shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h6">Read statements from a file</h2>
        <p class="small text-muted mb-2">A CSV with one line per fund per year, such as the annual tax statement export from the share
            registry (Computershare, MUFG / Link, Boardroom, Automic) or your fund manager. Columns are found by their names, for example
            "Franked distributions" or "AMIT cost base net amount - excess"; Code and Year are needed. Or use these headings:
            <code class="small">@FundStatementCsv.Template</code>. A statement already entered for the same fund and year is replaced.</p>
        <span asp-validation-for="Upload" class="text-danger small d-block"></span>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <input type="file" asp-for="Upload" accept=".csv,.txt" class="form-control form-control-sm w-auto" required />
            <button class="btn btn-sm btn-outline-primary"><i class="bi bi-file-earmark-arrow-up"></i> Check the file</button>
        </div>
    </div>
</form>

@if (Model.Preview is { } preview)
{
    <div class="card shadow-sm mb-3 border-primary">
        <div class="card-body pb-0">
            <h2 class="h6">What the file holds</h2>
            @if (preview.FileError is not null)
            {
                <div class="alert alert-danger small">@preview.FileError</div>
            }
            else
            {
                <p class="small mb-2">@preview.ValidCount statement@(preview.ValidCount == 1 ? "" : "s") ready to save@(preview.ErrorCount > 0 ? $", {preview.ErrorCount} line{(preview.ErrorCount == 1 ? "" : "s")} with problems (skipped)" : "").</p>
            }
        </div>
        @if (preview.Lines.Count > 0)
        {
            <table class="table table-sm align-middle mb-0">
                <thead class="table-light"><tr><th>Line</th><th>Fund</th><th>Year</th><th class="text-end">Cash</th><th class="text-end">Income</th>
                    <th class="text-end">Capital gains (gross)</th><th class="text-end">Cost base change</th><th>Notes</th></tr></thead>
                <tbody>
                    @foreach (var l in preview.Lines)
                    {
                        <tr class="@(l.IsValid ? "" : "table-danger")">
                            <td>@l.LineNumber</td>
                            @if (l.Value is { } s)
                            {
                                <td>@s.StockCode <span class="small text-muted">@s.ExchangeCode</span></td>
                                <td>@FinancialYear.Label(s.Year)</td>
                                <td class="text-end">@s.CashDistribution.ToString("C")</td>
                                <td class="text-end">@s.AssessableIncome.ToString("C")</td>
                                <td class="text-end">@((s.GrossDiscountGain + s.OtherGain).ToString("C"))</td>
                                <td class="text-end">@(s.NetCostBaseDecrease == 0 ? "" : s.NetCostBaseDecrease > 0 ? $"{s.NetCostBaseDecrease:C} decrease" : $"{-s.NetCostBaseDecrease:C} increase")</td>
                            }
                            else
                            {
                                <td colspan="6" class="small text-muted text-truncate" style="max-width: 30rem">@l.Text</td>
                            }
                            <td class="small">@string.Join(" ", l.Errors.Concat(l.Warnings))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (preview.ValidCount > 0)
        {
            <form method="post" asp-page-handler="Import" class="card-body">
                <input type="hidden" asp-for="Data" />
                <button class="btn btn-primary">Save @preview.ValidCount statement@(preview.ValidCount == 1 ? "" : "s")</button>
            </form>
        }
    </div>
}

<div class="card shadow-sm mb-3">
    <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light">
            <tr><th>Year</th><th>Fund</th><th class="text-end">Cash</th><th class="text-end">Income</th><th class="text-end">Capital gains (gross)</th>
                <th class="text-end">Cost base change</th><th class="text-end">Ties to cash</th><th></th></tr>
        </thead>
        <tbody>
            @if (Model.Statements.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted p-4">No statements yet.</td></tr>
            }
            @foreach (var s in Model.Statements)
            {
                <tr>
                    <td>@FinancialYear.Label(s.Year)</td>
                    <td><strong>@s.StockCode</strong> <span class="small text-muted">@s.ExchangeCode</span></td>
                    <td class="text-end">@s.CashDistribution.ToString("C")</td>
                    <td class="text-end">@s.AssessableIncome.ToString("C")</td>
                    <td class="text-end">@((s.GrossDiscountGain + s.OtherGain).ToString("C"))</td>
                    <td class="text-end">@(s.NetCostBaseDecrease == 0 ? "" : (s.NetCostBaseDecrease > 0 ? "Down " : "Up ") + Math.Abs(s.NetCostBaseDecrease).ToString("C"))</td>
                    <td class="text-end">@(Math.Abs(s.Difference) < 1 ? "Yes" : $"Out by {s.Difference:C}")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-route-edit="@s.Id">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<form method="post" asp-page-handler="Save" class="card shadow-sm">
    <div class="card-body">
        <h2 class="h6">@(i.Id == 0 ? "Add a statement" : "Change the statement")</h2>
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="row g-2 mb-2">
            <div class="col-sm-6 col-md-4"><label class="form-label" asp-for="Input.Fund">Fund</label>
                <select class="form-select" asp-for="Input.Fund"><option value="">Pick a fund</option>
                    @foreach (var f in Model.Funds) { <option value="@f">@f[(f.IndexOf(':') + 1)..] (@f[..f.IndexOf(':')])</option> }
                </select></div>
            <div class="col-sm-6 col-md-3"><label class="form-label" asp-for="Input.Year">Financial year</label>
                <select class="form-select" asp-for="Input.Year">
                    @foreach (var y in Model.Years) { <option value="@y">@FinancialYear.Label(y)</option> }
                </select></div>
            <div class="col-sm-6 col-md-3"><label class="form-label" asp-for="Input.CashDistribution">Cash distribution</label>
                <input class="form-control" asp-for="Input.CashDistribution" type="number" step="0.01" min="0" /></div>
        </div>
        @{
            var groups = new (string Title, (string Field, string Label, string Help)[] Fields)[]
            {
                ("Australian income", [("Franked", "Franked distributions", "Without the franking credits"), ("FrankingCredits", "Franking credits", ""),
                    ("Unfranked", "Unfranked distributions", "Including conduit foreign income"), ("Interest", "Interest", ""),
                    ("OtherIncome", "Other income", "Not NCMI"), ("Ncmi", "Non-concessional MIT income (NCMI)", "")]),
                ("Capital gains", [("DiscountedGain", "Discount method gains, after the fund's discount", "The amount shown as discounted capital gains; it's doubled here"),
                    ("OtherGain", "Indexation and other method gains", "")]),
                ("Foreign income and tax", [("ForeignIncome", "Assessable foreign income", "Including the foreign tax paid"), ("ForeignTaxCredits", "Foreign income tax offsets", ""),
                    ("TfnWithheld", "TFN amounts withheld", "")]),
                ("Cost base (AMIT)", [("CostBaseDecrease", "Net decrease, or tax-deferred amount", "Lowers the cost base of units held at the year end"),
                    ("CostBaseIncrease", "Net increase", "Raises the cost base: income attributed but not paid")]),
            };
        }
        @foreach (var g in groups)
        {
            <h3 class="h6 mt-3 text-muted">@g.Title</h3>
            <div class="row g-2">
                @foreach (var f in g.Fields)
                {
                    var value = typeof(PortfolioManager.Web.Pages.Payouts.FundStatementsModel.StatementForm).GetProperty(f.Field)!.GetValue(i) as decimal?;
                    <div class="col-sm-6 col-md-4">
                        <label class="form-label small mb-0" for="Input_@f.Field">@f.Label</label>
                        <input class="form-control" id="Input_@f.Field" name="Input.@f.Field" type="number" step="0.01" min="0" value="@value?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                        @if (f.Help.Length > 0) { <div class="form-text">@f.Help</div> }
                    </div>
                }
            </div>
        }
        <div class="mt-3" style="max-width: 40rem"><label class="form-label" asp-for="Input.Comment">Note</label><input class="form-control" asp-for="Input.Comment" maxlength="500" /></div>
        <div class="mt-3">
            <button class="btn btn-primary">Save</button>
            @if (i.Id != 0) { <a class="btn btn-link" asp-page="./FundStatements">Cancel</a> }
        </div>
        <p class="small text-muted mt-2 mb-0">The labels follow the ATO's standard AMMA statement. Check the figures against the statement: the
            "ties to cash" column compares the parts with the cash distribution.</p>
    </div>
</form>
