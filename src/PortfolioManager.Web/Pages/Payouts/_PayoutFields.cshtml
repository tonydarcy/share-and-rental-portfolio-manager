@model PayoutInput
@{
    // Set by the Edit page: a DRP payout's code and amounts are locked (they belong with its reinvestment trade).
    var editing = ViewData["Editing"] is true;
    var locked = ViewData["AmountsLocked"] is true;
    // Franking is Australian; elsewhere a dividend goes in one box (stored as unfranked)
    var au = RegionSettings.Current.IsAustralia;
}

<div class="row g-3 mb-3">
    <div class="col-sm-4">
        <label asp-for="StockCode" class="form-label">Stock code</label>
        <input asp-for="StockCode" class="form-control text-uppercase" placeholder="e.g. BHP" readonly="@locked" maxlength="50" />
        <div class="form-text">For bank interest, use the account name.</div>
    </div>
    <div class="col-sm-3">
        <label asp-for="StockExchangeCode" class="form-label">Exchange</label>
        <input asp-for="StockExchangeCode" class="form-control text-uppercase" readonly="@locked" maxlength="50" />
    </div>
    <div class="col-sm-5">
        <label asp-for="Date" class="form-label">Payment date</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
</div>

<fieldset disabled="@locked">
    <legend class="h6">Income</legend>
    <div class="row g-3 mb-3">
        @if (au)
        {
            <div class="col-6 col-md-3">
                <label asp-for="Franked" class="form-label">Franked amount</label>
                <input asp-for="Franked" type="number" step="0.01" min="0" class="form-control" />
            </div>
        }
        else
        {
            <input asp-for="Franked" type="hidden" />
        }
        <div class="col-6 col-md-3">
            <label asp-for="Unfranked" class="form-label">@(au ? "Unfranked amount" : "Dividend")</label>
            <input asp-for="Unfranked" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="Interest" class="form-label">Interest</label>
            <input asp-for="Interest" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="Other" class="form-label">Other income</label>
            <input asp-for="Other" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="TrustIncome" class="form-label">Trust income</label>
            <input asp-for="TrustIncome" type="number" step="0.01" min="0" class="form-control" />
        </div>
        @if (au)
        {
            <div class="col-6 col-md-3">
                <label asp-for="FrankingCredit" class="form-label">Franking credit</label>
                <input asp-for="FrankingCredit" type="number" step="0.01" min="0" class="form-control" />
                <div class="form-text">Not cash; from your statement.</div>
            </div>
        }
        else
        {
            <input asp-for="FrankingCredit" type="hidden" />
        }
    </div>

    <legend class="h6">Tax withheld</legend>
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <label asp-for="TaxWithheld" class="form-label">@(au ? "TFN withholding" : "Tax withheld")</label>
            <input asp-for="TaxWithheld" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="ForeignTax" class="form-label">Foreign tax</label>
            <input asp-for="ForeignTax" type="number" step="0.01" min="0" class="form-control" />
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <label asp-for="Total" class="form-label fw-bold">Cash received</label>
            <input asp-for="Total" type="number" step="0.01" min="0" class="form-control fw-bold" />
            <div class="form-text">Income less tax withheld.</div>
        </div>
    </div>
</fieldset>

@if (editing)
{
    <div class="form-text mb-3">
        @if (locked)
        {
            <span>This payout was reinvested (DRP), so its code and amounts stay with the reinvestment trade. To change them, delete the payout and its trade and add them again.</span>
        }
        else
        {
            <span>Saving updates the payout's ledger journal (if it has one) to match.</span>
        }
    </div>
}

<div class="mb-3">
    <label asp-for="Comment" class="form-label">Comment</label>
    <input asp-for="Comment" class="form-control" maxlength="500" />
</div>
<div class="form-check mb-3">
    <input asp-for="Confirmed" class="form-check-input" />
    <label asp-for="Confirmed" class="form-check-label">Payment received (confirmed)</label>
</div>
