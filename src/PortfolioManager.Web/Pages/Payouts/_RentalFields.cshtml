@model RentalPayoutInput
@{
    // The amounts are bound by index; the prefix is "Input" when used with <partial for="Input">
    string AmountName(int i) => ViewData.TemplateInfo.GetFullHtmlFieldName($"Amounts[{i}]");
    string AmountId(int i) => Html.GenerateIdFromName(AmountName(i));
}

<div class="row g-3 mb-3">
    <div class="col-sm-4">
        <label asp-for="PropertyCode" class="form-label">Property</label>
        <input asp-for="PropertyCode" class="form-control text-uppercase" placeholder="e.g. 12SMITHST" maxlength="50" />
        <div class="form-text">A short code; it shows in the Code column.</div>
    </div>
    <div class="col-sm-3">
        <label asp-for="ExchangeCode" class="form-label">Exchange</label>
        <input asp-for="ExchangeCode" class="form-control text-uppercase" maxlength="50" />
    </div>
    <div class="col-sm-5">
        <label asp-for="Date" class="form-label">Date</label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>
</div>

<fieldset>
    <legend class="h6">Income</legend>
    <div class="row g-3 mb-3">
        @for (var i = 0; i < RentalPayoutInput.Fields.Count; i++)
        {
            var f = RentalPayoutInput.Fields[i];
            if (!f.IsIncome) { continue; }
            <div class="col-6 col-md-3">
                <label for="@AmountId(i)" class="form-label">@f.Label</label>
                <input id="@AmountId(i)" name="@AmountName(i)" value="@Model.Amount(i).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0" class="form-control" />
            </div>
        }
    </div>

    <legend class="h6">Expenses</legend>
    <div class="row g-3 mb-3">
        @for (var i = 0; i < RentalPayoutInput.Fields.Count; i++)
        {
            var f = RentalPayoutInput.Fields[i];
            if (f.IsIncome) { continue; }
            <div class="col-6 col-md-3">
                <label for="@AmountId(i)" class="form-label">@f.Label</label>
                <input id="@AmountId(i)" name="@AmountName(i)" value="@Model.Amount(i).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0" class="form-control" />
            </div>
        }
    </div>
</fieldset>

<p class="mb-3">Net (income less expenses): <strong>@Model.Net.ToString("C")</strong> <span class="text-muted small">(worked out again when you save)</span></p>

<div class="mb-3">
    <label asp-for="Comment" class="form-label">Comment</label>
    <input asp-for="Comment" class="form-control" maxlength="500" />
</div>
