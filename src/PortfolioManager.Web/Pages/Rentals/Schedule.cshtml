@page
@model ScheduleModel
@{
    ViewData["Title"] = "Rental schedule";
}
<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <div>
        <h1 class="h2 mb-0">Rental property schedule</h1>
        @if (Model.Portfolio is not null) { <div class="text-muted">@Model.Portfolio.Name &middot; @FinancialYear.Label(Model.Year)</div> }
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary no-print" onclick="window.print()"><i class="bi bi-printer"></i> Print / PDF</button>
</div>
@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}
<partial name="_Nav" />
<partial name="_YearPicker" model="Model" />
<p class="text-muted small">Laid out like the ATO rental property schedule. Figures come from the yearly figures entered, agent statements, the maintenance
    log, the rent ledger, bills the tenant paid, linked loans and the depreciating assets and capital works. Each owner's column is their schedule.</p>
@if (Model.Schedule.Properties.Count == 0)
{
    <div class="alert alert-info">No rental properties have figures for @FinancialYear.Label(Model.Year). <a asp-page="/TaxWork/Rental">Add a property</a>.</div>
}
else
{
    <partial name="_Schedule" model="Model.Schedule" />
}
