@page
@model CodesModel
@{
    ViewData["Title"] = "Tax codes";
    var editing = Model.Input.TaxCodeId is not null;
    var tax = Model.TaxName;
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">@tax codes</h1>
    @if (Model.Current is not null)
    {
        <a asp-page="/SalesTax/Index" class="btn btn-sm btn-outline-secondary">@tax report</a>
    }
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}

<p class="text-muted">
    Use this if the portfolio is registered for GST, VAT or another sales tax. Give a tax code to each bank allocation, allocation
    rule or journal line that has tax in it, and the @tax report adds them up into the boxes of your return
    (in @Model.Region.Country.Name, the @Model.Preset.ReturnName). Anything without a code is left out of the report.
</p>

<div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>

<h2 class="h5">Settings</h2>
<form method="post" asp-page-handler="Setup" class="card shadow-sm mb-4">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label asp-for="Setup.TaxName" class="form-label">The tax is called</label>
            <input asp-for="Setup.TaxName" class="form-control" maxlength="30" required placeholder="GST, VAT, Sales tax" />
        </div>
        <div class="col-md-3">
            <label asp-for="Setup.ReportingMonths" class="form-label">Reported</label>
            <select asp-for="Setup.ReportingMonths" class="form-select">
                @foreach (var m in SalesTaxSetup.PeriodChoices)
                {
                    <option value="@m">@SalesTaxSetup.PeriodLabel(m)</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="Setup.ControlAccountId" class="form-label">Ledger account for the tax</label>
            <select asp-for="Setup.ControlAccountId" class="form-select">
                <option value="">Add a "@(Model.Setup.TaxName is { Length: > 0 } n ? n : tax) Control" account</option>
                @foreach (var a in Model.ControlAccounts)
                {
                    <option value="@a.AccountId">@a.Display</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">@(Model.Current is null ? "Set up" : "Save")</button>
        </div>
        <div class="col-12 form-text">
            Tax on sales and purchases goes to this account, so its balance is what you owe (or are owed). When you pay the tax office or get
            a refund, allocate the bank line to this account with no tax code.
        </div>
    </div>
</form>

@if (Model.Current is null)
{
    return;
}

<div class="d-flex justify-content-between flex-wrap align-items-center mb-2 gap-2">
    <h2 class="h5 mb-0">Codes</h2>
    <form method="post" asp-page-handler="Preset">
        <button type="submit" class="btn btn-sm btn-outline-primary">Add the usual codes for @Model.Region.Country.Name</button>
    </form>
</div>
@if (Model.Preset.Note is { } note)
{
    <p class="small text-muted mb-2">@note</p>
}

<div class="card shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th><th>Name</th><th>For</th><th class="text-end">Rate</th>
                    <th>Amount goes in box</th><th>Tax goes in box</th><th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Codes.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted p-4">No codes yet. Add the usual ones for @Model.Region.Country.Name, or add your own below.</td></tr>
                }
                @foreach (var c in Model.Codes)
                {
                    <tr class="@(c.TaxCodeId == Model.Input.TaxCodeId ? "table-active" : "") @(c.IsActive ? "" : "text-muted")">
                        <td class="fw-bold">@c.Code</td>
                        <td>@c.Name @if (!c.IsActive) { <span class="badge text-bg-secondary">Inactive</span> }</td>
                        <td>@c.Kind</td>
                        <td class="text-end">@c.Rate.ToString("0.##")%</td>
                        <td>@(c.AmountBoxes ?? "")@if (c.AmountBoxes is not null) { <span class="text-muted small"> (@(c.AmountIncludesTax ? "with tax" : "before tax"))</span> }</td>
                        <td>@(c.TaxBox ?? "")</td>
                        <td class="text-end text-nowrap">
                            <a asp-route-id="@c.TaxCodeId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            @if (!c.InUse)
                            {
                                <form method="post" asp-page-handler="Delete" asp-route-taxCodeId="@c.TaxCodeId" class="d-inline"
                                      onsubmit="return confirm('Delete this tax code?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<h2 class="h5">@(editing ? "Edit code" : "Add a code")</h2>
<form method="post" asp-page-handler="Save" class="card shadow-sm">
    <input type="hidden" asp-for="Input.TaxCodeId" />
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-2">
            <label asp-for="Input.Code" class="form-label">Code</label>
            <input asp-for="Input.Code" class="form-control text-uppercase" maxlength="10" required placeholder="e.g. GST" />
        </div>
        <div class="col-md-4">
            <label asp-for="Input.Name" class="form-label">Name</label>
            <input asp-for="Input.Name" class="form-control" maxlength="100" required placeholder="e.g. GST on sales" />
        </div>
        <div class="col-md-3">
            <label asp-for="Input.Kind" class="form-label">Used on</label>
            <select asp-for="Input.Kind" class="form-select">
                <option value="@TaxKind.Sales">Sales and income</option>
                <option value="@TaxKind.Purchases">Purchases and expenses</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.Rate" class="form-label">Rate (%)</label>
            <input asp-for="Input.Rate" type="number" step="0.0001" min="0" max="100" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label asp-for="Input.AmountBoxes" class="form-label">Amount goes in box(es)</label>
            <input asp-for="Input.AmountBoxes" class="form-control" maxlength="100" placeholder="e.g. G1, G2" />
        </div>
        <div class="col-md-3">
            <label asp-for="Input.AmountIncludesTax" class="form-label">Amount in those boxes</label>
            <select asp-for="Input.AmountIncludesTax" class="form-select">
                <option value="true">Includes the tax</option>
                <option value="false">Is before tax</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="Input.TaxBox" class="form-label">Tax goes in box</label>
            <input asp-for="Input.TaxBox" class="form-control" maxlength="20" placeholder="e.g. 1A" />
        </div>
        <div class="col-md-2">
            <label asp-for="Input.SortOrder" class="form-label">Order</label>
            <input asp-for="Input.SortOrder" type="number" class="form-control" placeholder="last" />
        </div>
        <div class="col-md-6">
            <div class="form-check">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label">Active (inactive codes stay on old entries but can't be picked)</label>
            </div>
        </div>
        <div class="col-md-6 d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary">@(editing ? "Save code" : "Add code")</button>
            @if (editing)
            {
                <a asp-page="/SalesTax/Codes" class="btn btn-outline-secondary">Cancel</a>
            }
        </div>
        <div class="col-12 form-text">
            Separate several boxes with commas. A changed rate only applies to entries from now on; tax already recorded keeps its amount.
        </div>
    </div>
</form>
