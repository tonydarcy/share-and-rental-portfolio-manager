@model PortfolioManager.Web.Pages.Shared.DocumentLinesView
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var taxed = Model.TaxCodes.Count > 0;
    var items = Model.Items.Where(i => i.Active || Model.Lines.Any(l => l.ItemId == i.ItemId)).ToList();
    var t1 = Model.Tracking.First;
    var t2 = Model.Tracking.Second;
    string N(int i, string field) => $"{Model.Prefix}[{i}].{field}";
}
<div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Lines</strong>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-add-line><i class="bi bi-plus-lg"></i> Add line</button>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0 document-lines" data-purchases="@(Model.Purchases ? "1" : "0")">
            <thead class="table-light">
                <tr>
                    @if (items.Count > 0) { <th style="min-width: 10rem">Item</th> }
                    <th style="min-width: 14rem">Description</th>
                    <th class="text-end" style="width: 6rem">Qty</th>
                    <th class="text-end" style="width: 8rem">Price</th>
                    <th style="min-width: 12rem">@Model.AccountLabel</th>
                    @if (taxed) { <th style="min-width: 9rem">@Model.TaxName</th> }
                    @if (t1 is not null) { <th style="min-width: 8rem">@t1.Name</th> }
                    @if (t2 is not null) { <th style="min-width: 8rem">@t2.Name</th> }
                    <th class="text-end" style="width: 8rem">Amount</th>
                    <th style="width: 3rem"></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    var l = Model.Lines[i];
                    <tr class="document-line">
                        @if (items.Count > 0)
                        {
                            <td>
                                <select name="@N(i, "ItemId")" class="form-select form-select-sm item" aria-label="Item">
                                    <option value="">None</option>
                                    @foreach (var it in items)
                                    {
                                        var price = Model.Purchases ? it.PurchasePrice : it.SalePrice;
                                        var account = Model.Purchases ? (it.Tracked ? it.InventoryAccountId : it.PurchaseAccountId) : it.SalesAccountId;
                                        var code = Model.Purchases ? it.PurchaseTaxCodeId : it.SalesTaxCodeId;
                                        <option value="@it.ItemId" selected="@(l.ItemId == it.ItemId)" data-name="@(it.Description ?? it.Name)"
                                                data-price="@price?.ToString(inv)" data-account="@account" data-tax="@code">@it.Display</option>
                                    }
                                </select>
                            </td>
                        }
                        <td><input name="@N(i, "Description")" value="@l.Description" class="form-control form-control-sm description" maxlength="500" aria-label="Description" /></td>
                        <td><input name="@N(i, "Quantity")" value="@l.Quantity?.ToString(inv)" type="number" step="any" class="form-control form-control-sm text-end qty" aria-label="Quantity" /></td>
                        <td><input name="@N(i, "UnitPrice")" value="@l.UnitPrice?.ToString(inv)" type="number" step="0.01" class="form-control form-control-sm text-end price" aria-label="Price" /></td>
                        <td>
                            <select name="@N(i, "AccountId")" class="form-select form-select-sm account" aria-label="@Model.AccountLabel">
                                @foreach (var a in Model.Accounts)
                                {
                                    <option value="@a.AccountId" selected="@(l.AccountId == a.AccountId)">@a.Display</option>
                                }
                            </select>
                        </td>
                        @if (taxed)
                        {
                            <td>
                                <select name="@N(i, "TaxCodeId")" class="form-select form-select-sm tax-code" aria-label="@Model.TaxName code">
                                    <option value="">No @Model.TaxName</option>
                                    @foreach (var c in Model.TaxCodes)
                                    {
                                        <option value="@c.TaxCodeId" selected="@(l.TaxCodeId == c.TaxCodeId)" data-rate="@c.Rate.ToString(inv)">@c.Code (@c.Rate.ToString("0.##", inv)%)</option>
                                    }
                                </select>
                            </td>
                        }
                        @if (t1 is not null)
                        {
                            <td>
                                <select name="@N(i, "Tracking1Id")" class="form-select form-select-sm" aria-label="@t1.Name">
                                    <option value=""></option>
                                    @foreach (var o in t1.Options.Where(o => o.Active || o.OptionId == l.Tracking1Id))
                                    {
                                        <option value="@o.OptionId" selected="@(l.Tracking1Id == o.OptionId)">@o.Name</option>
                                    }
                                </select>
                            </td>
                        }
                        @if (t2 is not null)
                        {
                            <td>
                                <select name="@N(i, "Tracking2Id")" class="form-select form-select-sm" aria-label="@t2.Name">
                                    <option value=""></option>
                                    @foreach (var o in t2.Options.Where(o => o.Active || o.OptionId == l.Tracking2Id))
                                    {
                                        <option value="@o.OptionId" selected="@(l.Tracking2Id == o.OptionId)">@o.Name</option>
                                    }
                                </select>
                            </td>
                        }
                        <td class="text-end amount"></td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-line" title="Remove line"><i class="bi bi-x-lg"></i><span class="visually-hidden">Remove line</span></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <div class="row justify-content-end">
            <div class="col-sm-6 col-md-4">
                <table class="table table-sm mb-0">
                    <tr><td>Subtotal</td><td class="text-end" data-net></td></tr>
                    @if (taxed) { <tr><td>@Model.TaxName</td><td class="text-end" data-tax></td></tr> }
                    <tr class="fw-bold"><td>Total</td><td class="text-end" data-total></td></tr>
                </table>
            </div>
        </div>
    </div>
</div>
