@inject CurrentPortfolio Current
@inject SiteBranding Site
@inject LegalSettings Legal
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var portfolios = signedIn ? await Current.GetAccessibleAsync() : [];
}
<!DOCTYPE html>
<html lang="@RegionSettings.Current.Format">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - @Site.Name</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#212529" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="@Site.Name" />
    <script>
        // The portfolio's date and number format and currency, for amounts shown by charts and scripts
        window.pmLocale = @Json.Serialize(RegionSettings.Current.Format);
        window.pmCurrency = @Json.Serialize(RegionSettings.Current.Currency);
    </script>
</head>
<body class="bg-body-tertiary@(signedIn ? " pm-signed-in" : "")">
    <partial name="_MainMenu" />

    <main class="container pb-5">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show" role="status">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (Legal.Enabled && ViewContext.ActionDescriptor is Microsoft.AspNetCore.Mvc.RazorPages.CompiledPageActionDescriptor page
            && LegalSettings.ShowsFiguresNote(page.ViewEnginePath))
        {
            <p class="small text-body-secondary border-start border-3 ps-2">@LegalSettings.FiguresNote</p>
        }
        else if (Legal.Enabled && ViewContext.ActionDescriptor is Microsoft.AspNetCore.Mvc.RazorPages.CompiledPageActionDescriptor assistant
            && LegalSettings.ShowsAssistantNote(assistant.ViewEnginePath))
        {
            <p class="small text-body-secondary border-start border-3 ps-2">@LegalSettings.AssistantNote</p>
        }
        @if (signedIn && ViewContext.ActionDescriptor is Microsoft.AspNetCore.Mvc.RazorPages.CompiledPageActionDescriptor { ViewEnginePath: "/Index" }
            && !AccountSecurity.HasTwoFactor(User)
            && (portfolios.Any(p => p.Access != PortfolioManager.Core.Portfolios.PortfolioAccess.Full) || portfolios.Count >= 3))
        {
            @* People who look after other people's records are the ones a stolen password hurts most *@
            <div class="alert alert-warning" role="status">
                You can open other people's or several portfolios. Protect them by turning on
                <a asp-page="/Account/TwoFactor">two-factor sign-in</a>: a code from your phone as well as your password.
            </div>
        }
        @RenderBody()
    </main>
    <footer class="container small text-body-secondary pb-4 d-print-none">
        @if (!string.IsNullOrWhiteSpace(Site.SupportEmail))
        {
            <span class="me-3">Need help? Email <a href="mailto:@Site.SupportEmail">@Site.SupportEmail</a></span>
        }
        @if (Legal.Enabled)
        {
            <a class="me-3" href="@(string.IsNullOrWhiteSpace(Legal.TermsUrl) ? Url.Page("/Legal/Terms") : Legal.TermsUrl)">Terms of use</a>
            <a class="me-3" href="@(string.IsNullOrWhiteSpace(Legal.PrivacyUrl) ? Url.Page("/Legal/Privacy") : Legal.PrivacyUrl)">Privacy</a>
            <a class="me-3" asp-page="/Legal/Disclaimer">Disclaimer</a>
        }
        @* The AGPL-3.0 licence asks a site running this software to offer its users the source code *@
        <a href="@Legal.SourceCodeUrl" rel="noopener">Source code</a>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/mobile.js" asp-append-version="true"></script>
    <script src="~/js/menu.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
