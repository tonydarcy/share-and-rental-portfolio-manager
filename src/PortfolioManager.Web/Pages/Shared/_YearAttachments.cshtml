@model IReadOnlyList<PortfolioManager.Core.Practice.Attachment>
@using PortfolioManager.Core.Practice
@* The year's supporting documents, listed in the printed packs; each opens from the Attachments page *@
<section class="pack-page mt-4">
    <h2 class="h4">Supporting documents</h2>
    @if (Model.Count == 0)
    {
        <p class="text-muted">No files are attached to this year. Add them on <a asp-page="/Attachments/Index">Attachments</a>.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead><tr><th>Document</th><th>For</th><th>Note</th></tr></thead>
            <tbody>
                @foreach (var a in Model.OrderBy(a => a.Kind).ThenBy(a => a.FileName))
                {
                    <tr>
                        <td><a asp-page="/Attachments/Index" asp-page-handler="Download" asp-route-id="@a.Id">@a.FileName</a></td>
                        <td>@AttachmentKinds.Label(a.Kind)@(a.TargetId is { } t ? $" {t}" : "")</td>
                        <td>@a.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
