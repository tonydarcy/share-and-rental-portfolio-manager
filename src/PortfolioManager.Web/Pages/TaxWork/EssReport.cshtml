@page
@model EssReportModel
@using PortfolioManager.Core.Tax
@{
    ViewData["Title"] = "ESS annual report";
    var i = Model.Input;
    var r = Model.Register;
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">@(Model.Statements ? "Employee share scheme statements" : "ESS annual report")</h1>
    <div class="d-flex gap-2 no-print">
        @if (Model.Statements)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-route-fy="@Model.Year">Back to the register</a>
            <button type="button" class="btn btn-sm btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Print / PDF</button>
        }
        else if (r is { Employees.Count: > 0 })
        {
            <a class="btn btn-sm btn-outline-secondary" asp-route-fy="@Model.Year" asp-route-statements="true"><i class="bi bi-file-earmark-person"></i> Employee statements</a>
            <a class="btn btn-sm btn-outline-secondary" asp-page-handler="Csv" asp-route-fy="@Model.Year"><i class="bi bi-download"></i> CSV</a>
        }
    </div>
</div>

@if (Model.NeedsMigration)
{
    <div class="alert alert-warning">This page needs the database update 2026-10-26-05-ess-employer-register.sql. Ask whoever runs this site to apply it.</div>
    return;
}
@if (Model.Portfolio is null || r is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}
@if (Model.Success is not null)
{
    <div class="alert alert-success">@Model.Success</div>
}

@if (Model.Statements)
{
    foreach (var e in r.Employees)
    {
        <div class="card shadow-sm mb-3" style="break-after: page">
            <div class="card-body">
                <h2 class="h5 mb-1">Employee share scheme statement, @FinancialYear.Label(r.Year)</h2>
                <p class="mb-3">From <strong>@Model.Portfolio.Name</strong> to <strong>@e.Employee</strong>@(e.EmployeeRef is null ? "" : $" ({e.EmployeeRef})")</p>
                <table class="table table-sm mb-3">
                    <thead><tr><th>Acquired</th><th>Interests</th><th>Scheme</th><th class="text-end">Market value</th><th class="text-end">You paid</th><th class="text-end">Discount</th></tr></thead>
                    <tbody>
                        @foreach (var g in e.Grants)
                        {
                            <tr>
                                <td>@g.Acquired.ToString("d MMM yyyy")@(g.TaxingPoint is { } t ? $" (taxing point {t:d MMM yyyy})" : "")</td>
                                <td>@g.Interests.ToString("#,##0.########") @g.Interest.ToLowerInvariant()</td>
                                <td>@EssSchemes.Label(g.Scheme)</td>
                                <td class="text-end">@((g.Scheme == EssSchemes.Deferral ? g.TaxingPointValue ?? 0 : g.MarketValue).ToString("C"))</td>
                                <td class="text-end">@g.AmountPaid.ToString("C")</td>
                                <td class="text-end">@g.Discount.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <h3 class="h6">For your tax return (item 12)</h3>
                <table class="table table-sm" style="max-width: 36rem">
                    <tbody>
                        <tr><td>D: Discount from taxed upfront schemes, eligible for reduction</td><td class="text-end">@e.UpfrontEligible.ToString("C")</td></tr>
                        <tr><td>E: Discount from taxed upfront schemes, not eligible for reduction</td><td class="text-end">@e.UpfrontNotEligible.ToString("C")</td></tr>
                        <tr><td>F: Discount from deferral schemes</td><td class="text-end">@e.Deferral.ToString("C")</td></tr>
                        <tr><td>A: Foreign source discounts</td><td class="text-end">@e.ForeignSource.ToString("C")</td></tr>
                        <tr><td>C: TFN amounts withheld from discounts</td><td class="text-end">@e.TfnWithheld.ToString("C")</td></tr>
                    </tbody>
                </table>
                @if (e.StartUp > 0)
                {
                    <p class="small">Interests under the start-up concession (@e.StartUp.ToString("C") of discount) aren't taxed now. They're taxed as a capital
                        gain when you sell them, with a cost base of what you paid.</p>
                }
                <p class="small text-muted mb-0">The discounts are the market value of the interests less what you paid. Keep this statement with your tax records.</p>
            </div>
        </div>
    }
    return;
}

<p class="text-muted">For an employer that gives its employees shares, rights or options under an employee share scheme (ESS). Record each
    grant here. For each financial year this works out each employee's discount, prints the statement you must give them by 14 July,
    and gives the figures for the ESS annual report due to the ATO by 14 August. The ATO report is lodged through Online services for
    business or your payroll or tax software: this page doesn't produce the ATO's own file format, and it doesn't keep employees' tax
    file numbers, addresses or dates of birth, which that report also needs.</p>

<form method="get" class="d-flex gap-2 align-items-center mb-3 no-print">
    <label class="form-label mb-0" for="fy">Financial year</label>
    <select class="form-select form-select-sm w-auto" id="fy" name="fy" onchange="this.form.submit()">
        @foreach (var y in Model.Years) { <option value="@y" selected="@(y == Model.Year)">@FinancialYear.Label(y)</option> }
    </select>
</form>

<div class="card shadow-sm mb-3">
    <div class="card-body pb-0">
        <h2 class="h6">Reported for @FinancialYear.Label(r.Year)</h2>
        <p class="small text-muted mb-2">Upfront and start-up grants are reported in the year they were acquired; a deferral scheme's grant in the
            year of its deferred taxing point.</p>
    </div>
    <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light">
            <tr><th>Employee</th><th>Acquired</th><th>Interests</th><th>Scheme</th><th class="text-end">Discount</th><th>Label</th><th class="text-end">TFN withheld</th><th></th></tr>
        </thead>
        <tbody>
            @if (r.Employees.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted p-4">Nothing to report for this year.</td></tr>
            }
            @foreach (var e in r.Employees)
            {
                foreach (var g in e.Grants)
                {
                    <tr class="@(g.TfnWithheld < g.WithholdingDue ? "table-warning" : "")">
                        <td>@e.Employee <span class="small text-muted">@e.EmployeeRef</span></td>
                        <td>@g.Acquired.ToString("d MMM yyyy")</td>
                        <td>@g.Interests.ToString("#,##0.########") @g.Interest.ToLowerInvariant()</td>
                        <td class="small">@EssSchemes.Label(g.Scheme)</td>
                        <td class="text-end">@g.Discount.ToString("C")</td>
                        <td>@EssSchemes.ReturnLabel(g.Scheme)</td>
                        <td class="text-end">@g.TfnWithheld.ToString("C")@(g.TfnWithheld < g.WithholdingDue ? $" (should be {g.WithholdingDue:C})" : "")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-route-edit="@g.Id" asp-route-fy="@Model.Year">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@g.Id" asp-route-fy="@Model.Year" class="d-inline"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
                        </td>
                    </tr>
                }
            }
        </tbody>
        @if (r.Employees.Count > 0)
        {
            <tfoot class="table-light fw-semibold"><tr><td colspan="4">@r.Employees.Count employee@(r.Employees.Count == 1 ? "" : "s")</td><td class="text-end">@r.TotalDiscount.ToString("C")</td><td colspan="3"></td></tr></tfoot>
        }
    </table>
</div>

@if (r.AwaitingTaxingPoint.Count > 0)
{
    <div class="alert alert-light border small">
        <strong>Deferral scheme grants not yet at their taxing point:</strong>
        @string.Join("; ", r.AwaitingTaxingPoint.Select(g => $"{g.Employee}, {g.Interests:#,##0.########} {g.Interest.ToLowerInvariant()} acquired {g.Acquired:d MMM yyyy}")).
        Edit each one to add its deferred taxing point when it happens (for example when the employee can sell, or leaves).
    </div>
}

<form method="post" asp-page-handler="Save" asp-route-fy="@Model.Fy" class="card shadow-sm">
    <div class="card-body">
        <h2 class="h6">@(i.Id == 0 ? "Add a grant" : "Change the grant")</h2>
        <input type="hidden" asp-for="Input.Id" />
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="row g-2">
            <div class="col-sm-6 col-md-4"><label class="form-label" asp-for="Input.Employee">Employee</label><input class="form-control" asp-for="Input.Employee" maxlength="200" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label" asp-for="Input.EmployeeRef">Payroll number (optional, not a TFN)</label><input class="form-control" asp-for="Input.EmployeeRef" maxlength="50" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label" asp-for="Input.Scheme">Kind of scheme</label>
                <select class="form-select" asp-for="Input.Scheme">
                    @foreach (var s in EssSchemes.All) { <option value="@s">@EssSchemes.Label(s)</option> }
                </select></div>
            <div class="col-sm-6 col-md-2"><label class="form-label" asp-for="Input.Interest">What</label>
                <select class="form-select" asp-for="Input.Interest">
                    @foreach (var s in EssSchemes.Interests) { <option value="@s">@s</option> }
                </select></div>
        </div>
        <div class="row g-2 mt-1">
            <div class="col-sm-6 col-md-3"><label class="form-label small mb-0" asp-for="Input.Acquired">Date acquired</label><input class="form-control" asp-for="Input.Acquired" type="date" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label small mb-0" asp-for="Input.Interests">How many</label><input class="form-control" asp-for="Input.Interests" type="number" step="any" min="0" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label small mb-0" asp-for="Input.MarketValue">Total market value when acquired</label><input class="form-control" asp-for="Input.MarketValue" type="number" step="0.01" min="0" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label small mb-0" asp-for="Input.AmountPaid">Total the employee paid</label><input class="form-control" asp-for="Input.AmountPaid" type="number" step="0.01" min="0" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label small mb-0" asp-for="Input.ExercisePrice">Exercise price (rights and options)</label><input class="form-control" asp-for="Input.ExercisePrice" type="number" step="any" min="0" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label small mb-0" asp-for="Input.TaxingPoint">Deferred taxing point (deferral only)</label><input class="form-control" asp-for="Input.TaxingPoint" type="date" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label small mb-0" asp-for="Input.TaxingPointValue">Total market value then</label><input class="form-control" asp-for="Input.TaxingPointValue" type="number" step="0.01" min="0" /></div>
            <div class="col-sm-6 col-md-3"><label class="form-label small mb-0" asp-for="Input.TfnWithheld">Tax withheld (no TFN quoted)</label><input class="form-control" asp-for="Input.TfnWithheld" type="number" step="0.01" min="0" /></div>
        </div>
        <div class="d-flex flex-wrap gap-3 mt-2">
            <div class="form-check"><input class="form-check-input" asp-for="Input.TfnQuoted" /><label class="form-check-label" asp-for="Input.TfnQuoted">The employee quoted their TFN (or ABN)</label></div>
            <div class="form-check"><input class="form-check-input" asp-for="Input.ForeignSource" /><label class="form-check-label" asp-for="Input.ForeignSource">From foreign employment</label></div>
        </div>
        <div class="mt-2" style="max-width: 40rem"><label class="form-label" asp-for="Input.Comment">Note</label><input class="form-control" asp-for="Input.Comment" maxlength="500" /></div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary">Save</button>
            @if (i.Id != 0) { <a class="btn btn-outline-secondary" asp-route-fy="@Model.Fy">Cancel</a> }
        </div>
    </div>
</form>
