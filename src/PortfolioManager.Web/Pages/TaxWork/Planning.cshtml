@page
@model PlanningModel
@using PortfolioManager.Core.TaxWork
@using PortfolioManager.Core.Tax
@{
    ViewData["Title"] = "Tax planning";
    var a = Model.Now;
    var b = Model.Plan;
    string Diff(decimal x, decimal y) => x == y ? "" : (y - x).ToString("C");
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Tax planning</h1>
    <button type="button" class="btn btn-sm btn-outline-secondary no-print" onclick="window.print()"><i class="bi bi-printer"></i> Print / PDF</button>
</div>

@if (Model.Portfolio is null || Model.Workpaper is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}
<partial name="_YearPicker" model="Model" />
@if (Model.EntityNow is { } en && Model.EntityPlan is { } ep)
{
    var smsf = Model.Workpaper.EntityType == PortfolioManager.Core.Clients.ClientEntityTypes.Smsf;
    <p class="text-muted small">Starts from this year's taxable income as recorded so far (@en.TaxableIncome.ToString("C0")), taxed at @en.RatePercent.ToString("0.#")%.
        Try extra income, deductions, a sale@(smsf ? " or contributions" : ""). Nothing is saved.
        @if (smsf) { <text>The exempt current pension income percentage in the tax settings (@((Model.Workpaper.Data.Settings.EcpiPercent ?? 0).ToString("0.##"))%) takes that share of extra investment income, gains and deductions out of tax.</text> }</p>
    <form method="get" class="no-print card shadow-sm mb-4"><div class="card-body">
        <input type="hidden" name="fy" value="@Model.Year" />
        <div class="row g-2">
            <div class="col-sm-4 col-lg-2"><label asp-for="ExtraIncome" class="form-label small mb-1">Extra income</label><input asp-for="ExtraIncome" type="number" step="1" class="form-control form-control-sm" /></div>
            <div class="col-sm-4 col-lg-2"><label asp-for="ExtraDeductions" class="form-label small mb-1">Extra deductions</label><input asp-for="ExtraDeductions" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
            <div class="col-sm-4 col-lg-2"><label asp-for="SaleProceeds" class="form-label small mb-1">Sell shares for</label><input asp-for="SaleProceeds" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
            <div class="col-sm-4 col-lg-2"><label asp-for="SaleCost" class="form-label small mb-1">with a cost base of</label><input asp-for="SaleCost" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
            <div class="col-sm-4 col-lg-2 d-flex align-items-end"><div class="form-check"><input asp-for="SaleLong" class="form-check-input" /><label asp-for="SaleLong" class="form-check-label small">Held over 12 months</label></div></div>
            @if (smsf)
            {
                <div class="col-sm-4 col-lg-2"><label asp-for="ExtraContributions" class="form-label small mb-1">Extra concessional contributions</label><input asp-for="ExtraContributions" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
            }
        </div>
        <button type="submit" class="btn btn-primary btn-sm mt-3">Work it out</button>
    </div></form>
    <div class="card shadow-sm"><div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th></th><th class="text-end">As things stand</th><th class="text-end">With the changes</th><th class="text-end">Difference</th></tr></thead>
            <tbody>
                <tr class="fw-bold"><td>Taxable income</td><td class="text-end">@en.TaxableIncome.ToString("C0")</td><td class="text-end">@ep.TaxableIncome.ToString("C0")</td><td class="text-end">@Diff(en.TaxableIncome, ep.TaxableIncome)</td></tr>
                <tr><td>Tax at @en.RatePercent.ToString("0.#")%</td><td class="text-end">@en.GrossTax.ToString("C")</td><td class="text-end">@ep.GrossTax.ToString("C")</td><td class="text-end">@Diff(en.GrossTax, ep.GrossTax)</td></tr>
                <tr><td>Foreign income tax offset</td><td class="text-end">@((-en.ForeignOffset).ToString("C"))</td><td class="text-end">@((-ep.ForeignOffset).ToString("C"))</td><td></td></tr>
                <tr><td>Franking credits@(smsf ? " (refundable)" : "")</td><td class="text-end">@((-en.FrankingOffset).ToString("C"))</td><td class="text-end">@((-ep.FrankingOffset).ToString("C"))</td><td class="text-end">@Diff(-en.FrankingOffset, -ep.FrankingOffset)</td></tr>
                <tr><td>TFN amounts and PAYG instalments</td><td class="text-end">@((-en.Credits).ToString("C"))</td><td class="text-end">@((-ep.Credits).ToString("C"))</td><td></td></tr>
                @if (smsf) { <tr><td>Supervisory levy</td><td class="text-end">@en.Levy.ToString("C")</td><td class="text-end">@ep.Levy.ToString("C")</td><td></td></tr> }
                <tr class="fw-bold table-active"><td>@(ep.Payable >= 0 ? "Tax to pay" : "Refund") at lodgment</td><td class="text-end">@en.Payable.ToString("C")</td><td class="text-end">@ep.Payable.ToString("C")</td><td class="text-end">@Diff(en.Payable, ep.Payable)</td></tr>
                @if (!smsf)
                {
                    <tr><td>Excess franking credits (become a tax loss)</td><td class="text-end">@en.ExcessFranking.ToString("C")</td><td class="text-end">@ep.ExcessFranking.ToString("C")</td><td></td></tr>
                    <tr><td>Fully franked dividend the year's tax would frank</td><td class="text-end">@en.MaxFrankedDividend.ToString("C")</td><td class="text-end">@ep.MaxFrankedDividend.ToString("C")</td><td class="text-end">@Diff(en.MaxFrankedDividend, ep.MaxFrankedDividend)</td></tr>
                }
            </tbody>
        </table>
    </div></div>
    <p class="small text-muted mt-3">@(smsf
        ? "An estimate for a complying fund: capital gains on assets held over 12 months get the one-third discount; non-arm's length income, the transfer balance cap and Division 296 aren't counted."
        : "An estimate: the rate is the one in the tax settings (25% for a base rate entity, else 30%). Companies get no capital gains discount. The franked dividend line assumes the franking account starts the year at nil.")</p>
    return;
}
@if (Model.Trust is { } tp)
{
    <p class="text-muted small">Try a split of the trust's net income so far (@Math.Max(0, Model.Workpaper.Reconciliation.TaxableIncome).ToString("C0"), of which
        @Math.Max(0, Model.Workpaper.Cgt.NetCapitalGain).ToString("C0") is net capital gain) between beneficiaries. Enter each one's income from elsewhere;
        the extra tax column is what their share costs them. Nothing is saved; the trustee's resolution is on the Distribution page.</p>
    <form method="get" class="no-print card shadow-sm mb-4"><div class="card-body">
        <input type="hidden" name="fy" value="@Model.Year" />
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-2">
                <thead><tr><th>Beneficiary</th><th>Type</th><th style="width:8rem">Share %</th><th style="width:11rem">Other taxable income</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < Model.B.Count && i < PlanningModel.BeneficiaryRows; i++)
                    {
                        <tr>
                            <td><input name="B[@i].Name" value="@Model.B[i].Name" maxlength="100" class="form-control form-control-sm" aria-label="Name" /></td>
                            <td><select name="B[@i].Type" class="form-select form-select-sm" aria-label="Type">
                                <option value="Individual" selected="@(Model.B[i].Type != "Company")">Individual</option>
                                <option value="Company" selected="@(Model.B[i].Type == "Company")">Company</option></select></td>
                            <td><input name="B[@i].Percent" value="@Model.B[i].Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0" max="100" class="form-control form-control-sm" aria-label="Share" /></td>
                            <td><input name="B[@i].OtherIncome" value="@Model.B[i].OtherIncome.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="1" class="form-control form-control-sm" aria-label="Other income" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <label class="form-label small mb-1" for="BucketRate">Company beneficiaries' rate</label>
        <select id="BucketRate" name="BucketRate" class="form-select form-select-sm w-auto d-inline-block ms-2">
            <option value="25" selected="@(Model.BucketRate != 30)">25% (base rate entity)</option>
            <option value="30" selected="@(Model.BucketRate == 30)">30%</option>
        </select>
        <button type="submit" class="btn btn-primary btn-sm ms-2">Work it out</button>
    </div></form>
    <div class="card shadow-sm"><div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th>Beneficiary</th><th class="text-end">Share</th><th class="text-end">Income</th><th class="text-end">Net capital gain</th><th class="text-end">Franking credits</th><th class="text-end">Tax without</th><th class="text-end">Tax with</th><th class="text-end">Extra tax</th></tr></thead>
            <tbody>
                @foreach (var x in tp.Beneficiaries)
                {
                    <tr><td>@x.Beneficiary.Name <span class="small text-muted">@x.Beneficiary.Type</span></td><td class="text-end">@x.Beneficiary.Percent.ToString("0.##")%</td>
                        <td class="text-end">@x.Income.ToString("C")</td><td class="text-end">@x.NetGain.ToString("C")</td><td class="text-end">@x.Franking.ToString("C")</td>
                        <td class="text-end">@x.TaxWithout.ToString("C")</td><td class="text-end">@x.TaxWith.ToString("C")</td><td class="text-end fw-bold">@x.ExtraTax.ToString("C")</td></tr>
                }
                @if (tp.Unallocated > 0)
                {
                    <tr class="text-danger"><td colspan="2">Not distributed: taxed to the trustee at @PortfolioManager.Core.TaxWork.TrustPlanner.TrusteeRatePercent% plus Medicare</td><td class="text-end">@tp.Unallocated.ToString("C")</td><td colspan="4"></td><td class="text-end fw-bold">@tp.TrusteeTax.ToString("C")</td></tr>
                }
                <tr class="fw-bold table-active"><td colspan="7">Tax on the trust's income across the family</td><td class="text-end">@tp.TotalTax.ToString("C")</td></tr>
            </tbody>
        </table>
    </div></div>
    <p class="small text-muted mt-3">An estimate. Individuals are taxed as residents with Medicare and the low income offset, and other income is taken as salary with no
        tax withheld. A company beneficiary's tax ignores the unpaid present entitlement and Division 7A rules, and a minor beneficiary's penalty rates
        (Division 6AA) aren't applied: check those before resolving.</p>
    return;
}
@if (!Model.IsIndividual || a is null || b is null)
{
    <div class="alert alert-info">Tax planning is for individuals, companies, trusts and super funds. Set the entity type under Clients > Client details.</div>
    return;
}

<p class="text-muted small">Starts from this year's investment income, capital gains and rental figures as recorded so far. Add the income from outside the portfolio,
    then try a sale, a deductible super contribution or extra deductions. Nothing is saved; the page address keeps the figures, so you can bookmark it.
    @if (!Model.Rates.Known) { <strong>The rates for @FinancialYear.Label(Model.Year) aren't known yet, so the nearest year's are used.</strong> }</p>

<form method="get" class="no-print">
    <input type="hidden" name="fy" value="@Model.Year" />
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <h2 class="h6">Outside the portfolio</h2>
                <div class="row g-2">
                    <div class="col-sm-4"><label asp-for="OtherIncome" class="form-label small mb-1">Salary and other income</label><input asp-for="OtherIncome" type="number" step="1" class="form-control form-control-sm" /></div>
                    <div class="col-sm-4"><label asp-for="Payg" class="form-label small mb-1">PAYG withheld</label><input asp-for="Payg" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
                    <div class="col-sm-4"><label asp-for="OtherDeductions" class="form-label small mb-1">Other deductions</label><input asp-for="OtherDeductions" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
                    <div class="col-12"><div class="form-check"><input asp-for="Senior" class="form-check-input" /><label asp-for="Senior" class="form-check-label small">Entitled to the seniors and pensioners tax offset (for the Medicare levy threshold)</label></div></div>
                    @if (Model.Workpaper!.Ess.UpfrontEligible > 0)
                    {
                        <div class="col-sm-6"><label asp-for="FringeBenefits" class="form-label small mb-1">Reportable fringe benefits</label><input asp-for="FringeBenefits" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
                        <div class="col-sm-6"><label asp-for="ReportableSuper" class="form-label small mb-1">Reportable employer super (salary sacrifice)</label><input asp-for="ReportableSuper" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
                        <p class="small text-muted mb-0">These are for the income test on the $1,000 employee share scheme reduction.</p>
                    }
                </div>
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm h-100"><div class="card-body">
                <h2 class="h6">What if</h2>
                <div class="row g-2">
                    <div class="col-sm-4"><label asp-for="SaleProceeds" class="form-label small mb-1">Sell shares for</label><input asp-for="SaleProceeds" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
                    <div class="col-sm-4"><label asp-for="SaleCost" class="form-label small mb-1">with a cost base of</label><input asp-for="SaleCost" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
                    <div class="col-sm-4 d-flex align-items-end"><div class="form-check"><input asp-for="SaleLong" class="form-check-input" /><label asp-for="SaleLong" class="form-check-label small">Held more than 12 months</label></div></div>
                    <div class="col-sm-6"><label asp-for="Contribution" class="form-label small mb-1">Personal super contribution to claim</label><input asp-for="Contribution" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
                    <div class="col-sm-6"><label asp-for="ExtraDeductions" class="form-label small mb-1">Extra deductions (prepaid interest, donations)</label><input asp-for="ExtraDeductions" type="number" step="1" min="0" class="form-control form-control-sm" /></div>
                </div>
                <p class="small text-muted mt-2 mb-0">The concessional cap for @FinancialYear.Label(Model.Year) is @Model.Caps.Concessional.ToString("C0"), including the employer's super.
                    Unused cap from the last 5 years can be added if the total super balance was under $500,000 at the previous 30 June.</p>
            </div></div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary mb-4">Work it out</button>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th></th><th class="text-end">As things stand</th><th class="text-end">With the changes</th><th class="text-end">Difference</th></tr></thead>
            <tbody>
                <tr><td>Salary and other income</td><td class="text-end">@a.In.OtherIncome.ToString("C")</td><td class="text-end">@b.In.OtherIncome.ToString("C")</td><td></td></tr>
                <tr><td>Investment income (dividends grossed up, interest, distributions, less expenses)</td><td class="text-end">@a.In.InvestmentIncome.ToString("C")</td><td class="text-end">@b.In.InvestmentIncome.ToString("C")</td><td></td></tr>
                <tr><td>Net rent</td><td class="text-end">@a.In.RentalNet.ToString("C")</td><td class="text-end">@b.In.RentalNet.ToString("C")</td><td></td></tr>
                @if (a.In.EssUpfrontEligible + a.In.EssOtherDiscounts > 0)
                {
                    <tr><td>Employee share scheme discounts</td><td class="text-end">@((a.In.EssUpfrontEligible + a.In.EssOtherDiscounts).ToString("C"))</td><td class="text-end">@((b.In.EssUpfrontEligible + b.In.EssOtherDiscounts).ToString("C"))</td><td></td></tr>
                }
                @if (a.In.EssUpfrontEligible > 0)
                {
                    <tr><td>$1,000 ESS reduction <span class="small text-muted">(income test @a.EssIncomeTest.ToString("C0") / @b.EssIncomeTest.ToString("C0"), limit @EssReduction.IncomeTestLimit.ToString("C0"))</span></td>
                        <td class="text-end">@((-a.EssReduction).ToString("C"))</td><td class="text-end">@((-b.EssReduction).ToString("C"))</td><td class="text-end">@Diff(-a.EssReduction, -b.EssReduction)</td></tr>
                }
                <tr><td>Net capital gain</td><td class="text-end">@a.In.NetCapitalGain.ToString("C")</td><td class="text-end">@b.In.NetCapitalGain.ToString("C")</td><td class="text-end">@Diff(a.In.NetCapitalGain, b.In.NetCapitalGain)</td></tr>
                <tr><td>Deductions</td><td class="text-end">@((-a.In.Deductions).ToString("C"))</td><td class="text-end">@((-b.In.Deductions).ToString("C"))</td><td class="text-end">@Diff(-a.In.Deductions, -b.In.Deductions)</td></tr>
                <tr><td>Personal super contribution claimed</td><td class="text-end">@((-a.In.ConcessionalDeduction).ToString("C"))</td><td class="text-end">@((-b.In.ConcessionalDeduction).ToString("C"))</td><td class="text-end">@Diff(-a.In.ConcessionalDeduction, -b.In.ConcessionalDeduction)</td></tr>
                <tr class="fw-bold"><td>Taxable income</td><td class="text-end">@a.TaxableIncome.ToString("C0")</td><td class="text-end">@b.TaxableIncome.ToString("C0")</td><td class="text-end">@Diff(a.TaxableIncome, b.TaxableIncome)</td></tr>
                <tr><td>Tax on taxable income</td><td class="text-end">@a.IncomeTax.ToString("C")</td><td class="text-end">@b.IncomeTax.ToString("C")</td><td class="text-end">@Diff(a.IncomeTax, b.IncomeTax)</td></tr>
                <tr><td>Low income tax offset</td><td class="text-end">@((-a.Lito).ToString("C"))</td><td class="text-end">@((-b.Lito).ToString("C"))</td><td class="text-end">@Diff(-a.Lito, -b.Lito)</td></tr>
                <tr><td>Foreign income tax offset</td><td class="text-end">@((-a.In.ForeignTaxOffset).ToString("C"))</td><td class="text-end">@((-b.In.ForeignTaxOffset).ToString("C"))</td><td></td></tr>
                <tr><td>Medicare levy (@Model.Rates.MedicarePercent.ToString("0.#")%)</td><td class="text-end">@a.Medicare.ToString("C")</td><td class="text-end">@b.Medicare.ToString("C")</td><td class="text-end">@Diff(a.Medicare, b.Medicare)</td></tr>
                <tr><td>Franking credits (refundable)</td><td class="text-end">@((-a.In.FrankingCredits).ToString("C"))</td><td class="text-end">@((-b.In.FrankingCredits).ToString("C"))</td><td></td></tr>
                <tr><td>PAYG and TFN amounts withheld</td><td class="text-end">@((-a.In.Withheld).ToString("C"))</td><td class="text-end">@((-b.In.Withheld).ToString("C"))</td><td></td></tr>
                <tr class="fw-bold table-active"><td>@(b.Payable >= 0 ? "Tax to pay" : "Refund") at lodgment</td><td class="text-end">@a.Payable.ToString("C")</td><td class="text-end">@b.Payable.ToString("C")</td><td class="text-end">@Diff(a.Payable, b.Payable)</td></tr>
                <tr><td>Contributions tax paid by the super fund (@(b.Division293 ? "30%, Division 293" : "15%"))</td><td class="text-end">@a.ContributionsTax.ToString("C")</td><td class="text-end">@b.ContributionsTax.ToString("C")</td><td class="text-end">@Diff(a.ContributionsTax, b.ContributionsTax)</td></tr>
                <tr class="fw-bold"><td>Total tax, yours and the fund's</td><td class="text-end">@a.TotalTax.ToString("C")</td><td class="text-end">@b.TotalTax.ToString("C")</td><td class="text-end">@Diff(a.TotalTax, b.TotalTax)</td></tr>
                <tr class="small text-muted"><td>Marginal rate (before Medicare)</td><td class="text-end">@a.MarginalRate.ToString("P0")</td><td class="text-end">@b.MarginalRate.ToString("P0")</td><td></td></tr>
            </tbody>
        </table>
    </div>
</div>
@if (b.In.ConcessionalDeduction > Model.Caps.Concessional)
{
    <div class="alert alert-warning mt-3">The contribution is over the @Model.Caps.Concessional.ToString("C0") concessional cap, before counting the employer's super.</div>
}
<p class="small text-muted mt-3">An estimate for a resident individual. The Medicare levy is reduced for low incomes (single threshold @Model.MedicareThresholds.Single.ToString("C0"),
    seniors @Model.MedicareThresholds.Senior.ToString("C0")@(Model.MedicareThresholds.Known ? "" : ", the latest known year's")); family thresholds aren't applied. It leaves out the Medicare levy surcharge, the senior and pensioner offset itself,
    HELP repayments and the foreign tax offset limit above $1,000. To claim a personal contribution the fund must acknowledge a notice of intent before the return is lodged.</p>
