@page
@model PortfolioManager.Web.Pages.Trades.FxCheckModel
@{
    ViewData["Title"] = "Foreign currency trades";
    var wrong = Model.Trades.Count(t => t.LooksWrong);
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Foreign currency trades</h1>
    <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">Share trades</a>
</div>

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}

<p class="text-muted small">
    For CGT each trade is converted to @Model.PortfolioCurrency at the exchange rate on its own date: the cost base and proceeds are the
    order total divided by the rate (units of the trade currency per 1 @Model.PortfolioCurrency). This lists every trade in another currency
    with the FX close on file for that date (from the daily price update). A rate more than 5% away, usually one left at 1 or entered the
    wrong way up, is flagged: delete the trade and add it again with the rate blank to use the FX close.
</p>
@if (wrong > 0)
{
    <div class="alert alert-warning">@wrong trade@(wrong == 1 ? "" : "s") look@(wrong == 1 ? "s" : "") to have the wrong exchange rate.</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th><th>Type</th><th>Code</th><th class="text-end">Order total</th>
                    <th class="text-end">Rate entered</th><th class="text-end">FX close</th>
                    <th class="text-end">@Model.PortfolioCurrency as entered</th><th class="text-end">@Model.PortfolioCurrency at FX close</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Trades.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted p-4">No trades in other currencies.</td></tr>
                }
                @foreach (var t in Model.Trades)
                {
                    <tr class="@(t.LooksWrong ? "table-warning" : "")">
                        <td class="text-nowrap">@t.Date.ToString("d MMM yyyy")</td>
                        <td>@t.Type</td>
                        <td><span class="fw-bold">@t.StockCode</span> <span class="text-muted small">@t.ExchangeCode</span></td>
                        <td class="text-end">@t.OrderTotal.ToString("N2") @t.Currency</td>
                        <td class="text-end">@t.EnteredRate.ToString("0.######")</td>
                        <td class="text-end">@(t.Market is { } m ? m.Rate.ToString("0.######") : "None on file")</td>
                        <td class="text-end">@t.EnteredTotal.ToString("N2")</td>
                        <td class="text-end">@(t.MarketTotal?.ToString("N2") ?? "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
