@page
@model PortfolioManager.Web.Pages.Trades.IndexModel
@{
    ViewData["Title"] = "Share trades";
}

<div class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">Share trades</h1>
    <a asp-page="/Trades/Add" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Add trade</a>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (Model.Portfolio is null)
{
    <div class="alert alert-info">You don't have access to any portfolios yet.</div>
    return;
}

<form method="get" class="card shadow-sm mb-3">
    <div class="card-body py-2 d-flex flex-wrap gap-3 align-items-center">
        <div class="d-flex align-items-center gap-2">
            <label for="code" class="form-label mb-0">Stock</label>
            <select id="code" name="code" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                <option value="">All stocks</option>
                @foreach (var c in Model.Codes)
                {
                    <option value="@c" selected="@(c == Model.Code)">@c</option>
                }
            </select>
        </div>
        @if (Model.OldestFirst)
        {
            <input type="hidden" name="oldestFirst" value="true" />
        }
        <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button></noscript>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>
                        <a asp-page="./Index" asp-route-code="@Model.Code" asp-route-oldestFirst="@(!Model.OldestFirst)"
                           class="link-dark text-decoration-none" title="Change sort order">
                            Date <i class="bi @(Model.OldestFirst ? "bi-sort-up" : "bi-sort-down")"></i>
                        </a>
                    </th>
                    <th>Type</th>
                    <th>Code</th>
                    <th>Name</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Brokerage</th>
                    <th>Ccy</th>
                    <th class="text-end">FX rate</th>
                    <th class="text-end">Order total</th>
                    <th class="text-end">Cost base / unit</th>
                    <th>Comment</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Trades.Count == 0)
                {
                    <tr><td colspan="13" class="text-center text-muted p-4">No trades found.</td></tr>
                }
                @foreach (var t in Model.Trades)
                {
                    <tr>
                        <td class="text-nowrap">@t.Date.ToString("dd-MMM-yyyy")</td>
                        <td><span class="badge @(t.Type.Trim().Equals("SELL", StringComparison.OrdinalIgnoreCase) ? "text-bg-warning" : "text-bg-info")">@t.Type.Trim().ToUpperInvariant()</span></td>
                        <td class="fw-bold">@t.StockCode <span class="text-muted small fw-normal">@t.ExchangeCode</span></td>
                        <td class="small">@t.Name</td>
                        <td class="text-end">@t.Quantity.ToString("#,##0.########")</td>
                        <td class="text-end">@t.PricePerUnit.ToString("#,##0.00##")</td>
                        <td class="text-end">@t.Brokerage.ToString("#,##0.00")</td>
                        <td class="small">@t.Currency</td>
                        <td class="text-end small">@t.ExchangeRate.ToString("0.####")</td>
                        <td class="text-end">@t.OrderTotal.ToString("#,##0.00")</td>
                        <td class="text-end">@t.CostBasisPerUnit.ToString("0.000")</td>
                        <td class="small text-muted">@t.Comment</td>
                        <td class="text-end text-nowrap">
                            @if (t.Type.Trim().Equals("SELL", StringComparison.OrdinalIgnoreCase))
                            {
                                <a asp-page="./Parcels" asp-route-id="@t.TradeId" class="btn btn-sm btn-outline-secondary" title="Which parcels this sale took">
                                    <i class="bi bi-stack"></i><span class="visually-hidden">Parcels</span>
                                </a>
                            }
                            <a asp-page="/Attachments/Index" asp-route-kind="Trade" asp-route-target="@t.TradeId" class="btn btn-sm btn-outline-secondary" title="Contract notes and other files">
                                <i class="bi bi-paperclip"></i><span class="visually-hidden">Attachments</span>
                            </a>
                            <a asp-page="./Delete" asp-route-id="@t.TradeId" class="btn btn-sm btn-outline-danger" title="Delete trade @t.TradeId">
                                <i class="bi bi-trash"></i><span class="visually-hidden">Delete</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="text-muted small mt-2">
    Prices, brokerage and order totals are in the trade's own currency. Editing a trade isn't available yet:
    there's no database procedure that updates a trade and its ledger entries together.
</p>
