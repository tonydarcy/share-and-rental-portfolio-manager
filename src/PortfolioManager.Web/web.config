<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- IIS only. Publishing adds the aspNetCore handler to this file. Uploads up to 256 MB, for restoring a portfolio
       backup with its attached files (Portfolio/Backup); other pages keep their own smaller limits. -->
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="268435456" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
